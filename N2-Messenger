    function sendMessage() {
      const input = document.getElementById('messageInput');
      const text = input.value.trim();
      if (!text) return;
      if (text.length > 10000) { showToast('Bericht is te lang (maximaal 10.000 tekens).'); return; }

      const msgId = 'msg-' + Math.random().toString(36).substring(2, 9);

      if (activePeerId === 'system') {
        renderMessageUI('system', text, 'outgoing', 'You', 'Broadcast', true, false, msgId, currentFullID);
        activeConnections.forEach(conn => {
          sendSecure(conn, {
            type: 'chat',
            channel: 'system',
            text: text,
            tag: 'CWL+ Broadcast',
            sender: currentFullID,
            msgId: msgId
          });
        });
      } else if (n2Groups.has(activePeerId)) {
        const sent = n2SendGroupMessage(activePeerId, text, msgId);
        renderMessageUI(
          activePeerId,
          text,
          'outgoing',
          'You',
          sent ? 'Groepschat' : 'Queue Buffer',
          true,
          !sent,
          msgId,
          currentFullID
        );
      } else {
        const conn = activeConnections.get(activePeerId);
        const isConnected = !!conn;

        const payload = {
          type: 'chat',
          text: text,
          tag: isConnected ? 'Direct P2P' : 'Queue Buffer',
          msgId: msgId
        };

        if (isConnected) {
          sendSecure(conn, payload);
          renderMessageUI(activePeerId, text, 'outgoing', 'You', 'Direct P2P', true, false, msgId, currentFullID);
        } else {
          enqueueMessage(activePeerId, payload);
          renderMessageUI(activePeerId, text, 'outgoing', 'Jij (gebufferd)', 'Queue Buffer', true, true, msgId, currentFullID);
        }
      }

      playAudioPreset(currentMsgSound);
      input.value = '';
    }

