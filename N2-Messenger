      n2MissedCalls.unshift({callId:String(callId).slice(0,160),peerId:String(peerId).slice(0,200),name:n2SafeCallName(peerId),timestamp:Date.now()});
      n2MissedCalls.splice(100);
      n2RenderMissedCalls(); n2UpdateMissedCallsBadge(); n2SaveMissedCalls();
