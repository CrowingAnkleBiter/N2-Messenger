    async function configureN2TurnServer() {
      if (!n2VaultUnlocked || !n2VaultKey) { showToast('Ontgrendel eerst de beveiligde kluis.'); return; }
      let current = null;
      try { current = await n2VaultGet(N2_VAULT_TURN_KEY, null); } catch (_) {}
      const urls = prompt('TURN-server-URL (bijv. turns:turn.example.com:5349 of turn:turn.example.com:3478). Leegmaken schakelt TURN uit.', current?.urls || '');
      if (urls === null) return;
      if (!urls.trim()) {
        await n2VaultSet(N2_VAULT_TURN_KEY, null);
        showToast('TURN uitgeschakeld; STUN blijft actief.');
        return;
      }
      const normalizedUrls = urls.split(',').map(v => v.trim()).filter(Boolean);
      if (!normalizedUrls.length || normalizedUrls.some(v => !/^turns?:/i.test(v))) {
        showToast('Ongeldige TURN-URL. Gebruik turn: of turns:.'); return;
      }
      const username = prompt('TURN-gebruikersnaam (geleverd door je TURN-provider):', current?.username || '');
      if (username === null) return;
      const credential = prompt('TURN-wachtwoord/credential (geleverd door je TURN-provider):', current?.credential || '');
      if (credential === null) return;
      if (!username.trim() || !credential) { showToast('TURN vereist een gebruikersnaam en credential.'); return; }
      await n2VaultSet(N2_VAULT_TURN_KEY, {urls: normalizedUrls, username: username.trim(), credential});
      showToast('TURN-instellingen versleuteld opgeslagen. Vernieuw de P2P-verbinding om ze toe te passen.');
    }

    let n2RefreshInProgress = false;
    async function refreshP2PConnection() {
      if (n2RefreshInProgress) {
        showToast('P2P-verbinding wordt al vernieuwd…');
        return;
      }
      if (!isLoggedIn) {
        if (n2VaultUnlocked && n2VaultKey) {
          isLoggedIn = true;
          n2StartupInloggenActive = false;
          n2SetStartupLockVisible(false);
        } else {
          showToast('Log eerst in om de P2P-verbinding te herstellen.');
          return;
        }
      }
      n2RefreshInProgress = true;
      const refreshBtn = document.getElementById('n2ConnectionRefreshBtn');
      if (refreshBtn) refreshBtn.disabled = true;
      try {
        // De naam wordt alleen bij expliciet vernieuwen opgeslagen.
        const nameTag = String(document.getElementById('nameTagInput')?.value || '').trim();
        localStorage.setItem(SAVED_NAMETAG_KEY, nameTag);
        currentFullID = currentWillekeurigNum + (nameTag ? '-' + nameTag : '');
        const display = document.getElementById('myNodeNameDisplay');
        if (display) display.innerText = currentFullID || 'Mijn Node';
        applyAvatarElement(document.getElementById('myAvatar'), currentFullID, 'N²');

        // Sluit oude verbindingen volledig en wis sessiesleutels; de nieuwe sessies worden opnieuw onderhandeld.
        for (const conn of activeConnections.values()) { try { conn.close(); } catch (_) {} }
        activeConnections.clear();
        secureSessions.clear();
        securePendingQueues.clear();
        peerStatuses.clear();
        if (peer) { try { peer.destroy(); } catch (e) { console.warn('PeerJS cleanup tijdens refresh:', e); } peer = null; }
        n2PeerReadyPromise = null;

        // Geef de signalingserver even de tijd om het oude ID vrij te geven voordat hetzelfde ID opnieuw wordt geregistreerd.
        await new Promise(resolve => setTimeout(resolve, 500));
        try {
          await initPeerJS();
        } catch (firstError) {
          // Sommige signalingservers laten een ID heel kort als bezet staan na destroy(). Probeer één keer opnieuw.
          const errType = firstError?.type || firstError?.message || '';
          if (errType !== 'unavailable-id' && errType !== 'PEER_OPEN_TIMEOUT') throw firstError;
          console.warn('P2P refresh: eerste registratiepoging mislukt; tweede poging volgt.', firstError);
          if (peer) { try { peer.destroy(); } catch (_) {} peer = null; }
          n2PeerReadyPromise = null;
          await new Promise(resolve => setTimeout(resolve, 1200));
          await initPeerJS();
        }

        // initPeerJS triggert reconnectSavedPeers bij de open-event; deze melding verschijnt pas als de node echt online is.
        showToast('P2P-node is vernieuwd en online: ' + escapeHTML(peer?.id || currentFullID));
        renderZijbalkTabs();
      } catch(e) {
        console.error('N² P2P refresh mislukt:', e);
        const type = e?.type || e?.message || 'onbekende fout';
        const friendly = type === 'unavailable-id'
