    function initEmojiPickerDrag() {
      const picker = document.getElementById('emojiPicker');
      const handle = picker ? picker.querySelector('.emoji-picker-header') : null;
      if (!picker || !handle || handle.dataset.dragReady === 'true') return;
      handle.dataset.dragReady = 'true';

      let dragging = false;
      let offsetX = 0;
      let offsetY = 0;

      handle.addEventListener('pointerdown', (event) => {
        if (event.target.closest('button, input')) return;
        if (!picker.classList.contains('open')) return;

        const rect = picker.getBoundingClientRect();
        picker.style.transform = 'none';
        picker.style.left = `${rect.left}px`;
        picker.style.top = `${rect.top}px`;
        offsetX = event.clientX - rect.left;
        offsetY = event.clientY - rect.top;
        dragging = true;
        picker.classList.add('dragging');
        handle.setPointerCapture?.(event.pointerId);
        event.preventDefault();
      });

      handle.addEventListener('pointermove', (event) => {
        if (!dragging) return;
        const rect = picker.getBoundingClientRect();
        const maxLeft = Math.max(8, window.innerWidth - rect.width - 8);
        const maxTop = Math.max(8, window.innerHeight - rect.height - 8);
        const left = Math.max(8, Math.min(event.clientX - offsetX, maxLeft));
        const top = Math.max(8, Math.min(event.clientY - offsetY, maxTop));
        picker.style.left = `${left}px`;
        picker.style.top = `${top}px`;
        event.preventDefault();
      });

      const stopDrag = (event) => {
        if (!dragging) return;
        dragging = false;
        picker.classList.remove('dragging');
        try { handle.releasePointerCapture?.(event.pointerId); } catch (e) {}
      };

      handle.addEventListener('pointerup', stopDrag);
      handle.addEventListener('pointercancel', stopDrag);
      window.addEventListener('blur', () => {
        dragging = false;
        picker.classList.remove('dragging');
      });
    }

