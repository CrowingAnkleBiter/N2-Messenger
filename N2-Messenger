    async function loginUserNode() {
      const nameTag = String(document.getElementById('nameTagInput')?.value || '').trim();
      // Store the literal name tag. Escape only when rendering it in HTML.
      localStorage.setItem(SAVED_NAMETAG_KEY, nameTag);
      currentFullID = currentWillekeurigNum + (nameTag ? '-' + nameTag : '');
      currentCustomProfileStatus = String(localStorage.getItem(SAVED_CUSTOM_STATUS_KEY) || '').trim().slice(0, 160);
      const nameDisplay = document.getElementById('myNodeNameDisplay');
      if (nameDisplay) nameDisplay.innerText = currentFullID || 'Mijn Node';
      updateMyStatusDisplay();
      const customStatusInput = document.getElementById('n2CustomStatusInput');
      if (customStatusInput) customStatusInput.value = currentCustomProfileStatus;
      applyAvatarElement(document.getElementById('myAvatar'), currentFullID, 'N²');

      // Unlocking the local encrypted vault is the login requirement. The remote
      // PeerJS signaling service must not prevent the user opening local chats.
      try {
        await initN2Identity();
      } catch (e) {
        const msg = e?.message === 'N2_VAULT_BAD_PASSWORD' ? 'Onjuist beveiligingswachtwoord.' :
          e?.message === 'N2_VAULT_WEAK_PASSWORD' ? 'Wachtwoord te zwak: minimaal 12 tekens.' :
          e?.message === 'N2_VAULT_PASSWORD_MISMATCH' ? 'Wachtwoorden komen niet overeen.' :
          e?.message === 'N2_VAULT_CANCELLED' ? 'Beveiligde ontgrendeling geannuleerd.' :
          e?.message === 'N2_VAULT_DECRYPT_FAILED' ? 'De kluis kon niet worden ontsleuteld. Controleer het wachtwoord of de kluisgegevens.' :
          'Veilige login gestopt: Web Crypto is niet beschikbaar.';
        showToast(msg);
        console.error('N² secure login error:', e);
        return false;
      }

      // Mark the local session as logged in before PeerJS opens: the open event
      // can fire quickly and reconnectSavedPeers() checks isLoggedIn.
      isLoggedIn = true;
      const loginBtn = document.getElementById('loginBtn');
      if (loginBtn) {
        loginBtn.innerText = 'Uitloggen';
        loginBtn.style.background = 'rgba(248, 113, 113, 0.25)';
      }
      const statusDot = document.getElementById('myStatusDot');
      if (statusDot) statusDot.className = 'status-indicator status-online';
      const liveDot = document.getElementById('networkLiveDot');
      if (liveDot) liveDot.style.background = '#10b981';
      n2StartupInloggenActive = false;
      n2SetStartupLockVisible(false);
      showToast('Ingelogd als: ' + escapeHTML(currentFullID));
      playN2Tone('login');

      // Start/reconnect P2P in the background. A signaling outage should show a
      // connection error, but must not roll back a successful local login.
      Promise.resolve().then(() => initPeerJS()).then(() => {
        if (isLoggedIn) reconnectSavedPeers();
      }).catch(e => {
        console.error('N² PeerJS init error:', e);
        const type = e?.type || e?.message || 'onbekende fout';
        showToast(type === 'PEER_OPEN_TIMEOUT'
          ? 'Lokaal ingelogd, maar de P2P-server reageert niet. Probeer ↻ opnieuw.'
          : 'Lokaal ingelogd; P2P kon niet starten (' + type + '). Probeer ↻ opnieuw.');
      });
      return true;
    }

