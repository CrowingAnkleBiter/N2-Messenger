    function n2WaitForPeerOpen(peerInstance, timeoutMs = 15000) {
      if (peerInstance && peerInstance.open && peerInstance.id) return Promise.resolve(peerInstance.id);
      return new Promise((resolve, reject) => {
        if (!peerInstance) { reject(new Error('PEER_NOT_CREATED')); return; }
        let settled = false;
        const cleanup = () => {
          clearTimeout(timer);
          try { peerInstance.off('open', onOpen); } catch (_) {}
          try { peerInstance.off('error', onError); } catch (_) {}
        };
        const finish = (fn, value) => {
          if (settled) return;
          settled = true;
          cleanup();
          fn(value);
        };
        const onOpen = id => finish(resolve, id);
        const onError = err => finish(reject, err || new Error('PEER_OPEN_FAILED'));
        const timer = setTimeout(() => finish(reject, new Error('PEER_OPEN_TIMEOUT')), timeoutMs);
        peerInstance.on('open', onOpen);
        peerInstance.on('error', onError);
        // Account for the peer opening between the initial check and listener setup.
        if (peerInstance.open && peerInstance.id) finish(resolve, peerInstance.id);
      });
    }

    async function initPeerJS() {
      // Don't let the UI try to connect before PeerJS has completed signaling setup.
      if (peer && !peer.destroyed && !peer.disconnected && peer.id === currentFullID) {
        if (peer.open) return peer.id;
        if (n2PeerReadyPromise) return n2PeerReadyPromise;
        n2PeerReadyPromise = n2WaitForPeerOpen(peer);
        try { return await n2PeerReadyPromise; }
        finally { n2PeerReadyPromise = null; }
      }
      if (peer) {
        try { peer.destroy(); } catch (e) { console.warn('PeerJS cleanup:', e); }
        peer = null;
      }
      const iceServers = [{urls: 'stun:stun.l.google.com:19302'}];
      try {
        const turn = await n2VaultGet(N2_VAULT_TURN_KEY, null);
        if (turn && Array.isArray(turn.urls) && turn.urls.length && turn.username && turn.credential) {
          iceServers.push({urls: turn.urls, username: turn.username, credential: turn.credential});
        }
      } catch (e) { console.warn('N² TURN-config kon niet worden geladen; STUN wordt gebruikt.', e); }

      if (typeof Peer !== 'function') throw new Error('PEERJS_LIBRARY_UNAVAILABLE');
      peer = new Peer(currentFullID, {config: {iceServers}});

      peer.on('open', (id) => {
        showToast("Online op P2P-netwerk: " + escapeHTML(id));
        reconnectSavedPeers();
      });
      peer.on('connection', (conn) => setupConnection(conn));
      peer.on('disconnected', () => {
        showToast('P2P-signaling is verbroken. Druk op ↻ om opnieuw te verbinden.');
      });
      peer.on('error', (err) => {
        console.warn("PeerJS-fout:", err?.type || err);
        const messages = {
          'peer-unavailable': 'Node niet bereikbaar. Controleer het ID en of de mobiel online is.',
          'unavailable-id': 'Dit node-ID is al in gebruik. Sluit de andere sessie of kies een nieuw ID.',
          'invalid-id': 'Ongeldig node-ID. Gebruik het volledige ID dat op het andere apparaat wordt getoond.',
          'network': 'P2P-signalingprobleem. Controleer internet of de PeerJS-server.',
          'server-error': 'De PeerJS-server gaf een fout. Probeer opnieuw via ↻.',
          'socket-error': 'De verbinding met de PeerJS-signalingserver is mislukt.',
          'socket-closed': 'De PeerJS-signalingverbinding is gesloten.',
          'webrtc': 'WebRTC kon geen verbinding opbouwen. TURN kan nodig zijn.'
        };
        showToast(messages[err?.type] || ('P2P-fout: ' + (err?.type || 'onbekend')));
      });

      n2PeerReadyPromise = n2WaitForPeerOpen(peer);
      try {
        const id = await n2PeerReadyPromise;
        return id;
      } catch (e) {
        try { peer?.destroy(); } catch (_) {}
        peer = null;
        throw e;
      } finally {
        n2PeerReadyPromise = null;
      }
    }

