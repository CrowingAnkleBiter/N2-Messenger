<script id="n2-external-browser-search-js">
(function(){
  const DDG='https://duckduckgo.com/?q=';
  function openExternal(value){
    const raw=(value||'').trim();
    const destination=raw ? (/^https?:\/\//i.test(raw) ? raw : DDG+encodeURIComponent(raw)) : 'https://duckduckgo.com/';
    window.open(destination,'_blank','noopener,noreferrer');
  }
  window.n2OpenExternalBrowser=function(){ openExternal(''); };
  window.n2WebSearchSubmit=function(event){
    if(event) event.preventDefault();
    const input=document.getElementById('n2WebSearchInput');
    openExternal(input ? input.value : '');
    if(input) input.select();
    return false;
  };
})();
</script>
