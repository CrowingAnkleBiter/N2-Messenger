    function n2CallFromMissed(index){const x=n2MissedCalls[index];if(!x)return;n2RemoveMissedCall(index);startAudioCall(x.peerId);}
    function n2RemoveMissedCall(index){if(index<0||index>=n2MissedCalls.length)return;n2MissedCalls.splice(index,1);n2RenderMissedCalls();n2SaveMissedCalls();}
    function n2ClearMissedCalls(){n2MissedCalls.splice(0,n2MissedCalls.length);n2RenderMissedCalls();n2SaveMissedCalls();}
    function toggleN2MissedCalls(force){const p=document.getElementById('n2MissedCallsPanel');if(!p)return;p.hidden=typeof force==='boolean'?!force:!p.hidden;if(!p.hidden)n2RenderMissedCalls();}

    function n2InitRadioUI(){
      const select=document.getElementById('n2RadioStationSelect'),list=document.getElementById('n2RadioStationList');if(!select||!list)return;
      select.innerHTML=N2_RADIO_STATIONS.map(s=>`<option value="${escapeHTML(s.id)}">${escapeHTML(s.name)}</option>`).join('');
      list.innerHTML=N2_RADIO_STATIONS.map(s=>`<div class="n2-radio-station"><div style="min-width:0"><div class="n2-radio-station-name">${escapeHTML(s.name)}</div><div class="n2-radio-station-url">${escapeHTML(s.url)}</div></div><button type="button" class="n2-v61-mini" onclick="n2PlayRadioById('${escapeHTML(s.id)}')">▶</button></div>`).join('');
    }
    function n2PlayRadioById(id){const s=N2_RADIO_STATIONS.find(x=>x.id===id);if(!s)return;n2StartRadio(s.name,s.url);}
    function n2PlaySelectedRadio(){const id=document.getElementById('n2RadioStationSelect')?.value;n2PlayRadioById(id);}
    function n2PlayCustomRadio(){const input=document.getElementById('n2RadioCustomUrl');const url=String(input?.value||'').trim();if(!/^https:\/\//i.test(url)){showToast('Gebruik een HTTPS radio-stream URL.');return;}n2StartRadio('Eigen radio-stream',url);}
    function n2StartRadio(name,url){
      const audio=document.getElementById('n2RadioAudio');if(!audio)return;
      try{const u=new URL(url);if(u.protocol!=='https:')throw new Error('HTTPS_REQUIRED');audio.src=u.href;audio.play().then(()=>{const now=document.getElementById('n2RadioNow');if(now)now.textContent='📻 '+name;}).catch(()=>{const now=document.getElementById('n2RadioNow');if(now)now.textContent='📻 '+name+' — druk op afspelen';});}catch(_){showToast('Ongeldige radio-stream URL.');}
    }
    function n2StopRadio(){const a=document.getElementById('n2RadioAudio');if(!a)return;a.pause();a.removeAttribute('src');a.load();const now=document.getElementById('n2RadioNow');if(now)now.textContent='Geen station actief';}
    function toggleN2Radio(force){const p=document.getElementById('n2RadioPanel');if(!p)return;p.hidden=typeof force==='boolean'?!force:!p.hidden;if(!p.hidden)n2InitRadioUI();}

    // ==========================================
    // N² AUDIO BELLEN (WebRTC audio-only)
    // ==========================================
    let n2AudioCall = null;
    const n2PendingAudioCalls = new Map();
    const n2AudioIceQueues = new Map();
    const N2_AUDIO_RTC_CONFIG = {
      iceServers: [
        { urls: 'stun:stun.l.google.com:19302' },
        { urls: 'stun:stun.cloudflare.com:3478' }
      ]
    };

    function toggleN2CallWindow(forceMinimized) {
      const overlay = document.getElementById('n2AudioCallOverlay');
      const button = document.getElementById('n2CallMinimizeBtn');
      if (!overlay) return;
      const minimize = typeof forceMinimized === 'boolean' ? forceMinimized : !overlay.classList.contains('is-minimized');
      overlay.classList.toggle('is-minimized', minimize);
      if (button) {
        button.textContent = minimize ? '↗' : '−';
        button.title = minimize ? 'Gespreksvenster vergroten' : 'Gespreksvenster verkleinen';
        button.setAttribute('aria-label', button.title);
      }
      overlay.setAttribute('aria-modal', minimize ? 'false' : 'true');
    }

    function n2SetCallOverlay(show, peerId = '', status = '', actionsHtml = '') {
      const overlay = document.getElementById('n2AudioCallOverlay');
      const title = document.getElementById('n2CallTitle');
      const statusEl = document.getElementById('n2CallStatus');
      const actions = document.getElementById('n2CallActions');
      const avatar = document.getElementById('n2CallAvatar');
      if (!overlay) return;
      if (!show) { overlay.style.display = 'none'; overlay.classList.remove('is-minimized'); actions.innerHTML = ''; toggleN2CallWindow(false); return; }
      const profile = peerProfiles.get(peerId) || {};
      title.textContent = profile.name || peerId || 'Audio-oproep';
      statusEl.textContent = status || '';
      avatar.textContent = getInitials(profile.name || peerId || 'N²');
      avatar.style.backgroundImage = profile.photo ? `url('${String(profile.photo).replace(/'/g, '%27')}')` : '';
      actions.innerHTML = actionsHtml;
      overlay.style.display = 'flex';
    }

    function n2StartRingtone() {
      try {
        if (!window.AudioContext && !window.webkitAudioContext) return;
        const Ctx = window.AudioContext || window.webkitAudioContext;
        if (!window.n2CallToneCtx) window.n2CallToneCtx = new Ctx();
        const ctx = window.n2CallToneCtx;
        if (ctx.state === 'suspended') ctx.resume().catch(() => {});
        if (window.n2CallToneTimer) clearInterval(window.n2CallToneTimer);
        const tone = () => {
          const osc = ctx.createOscillator(), gain = ctx.createGain();
          osc.type = 'sine'; osc.frequency.value = 880;
          gain.gain.setValueAtTime(0.0001, ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.12, ctx.currentTime + 0.02);
          gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 0.35);
          osc.connect(gain).connect(ctx.destination); osc.start(); osc.stop(ctx.currentTime + 0.36);
        };
        tone(); window.n2CallToneTimer = setInterval(tone, 1400);
      } catch (_) {}
    }
    function n2StopRingtone() {
      if (window.n2CallToneTimer) clearInterval(window.n2CallToneTimer);
      window.n2CallToneTimer = null;
    }

    function n2EndAudioCall(sendSignal = true, reason = 'Call ended') {
      const call = n2AudioCall;
      n2StopRingtone();
      if (sendSignal && call?.peerId) {
        const conn = activeConnections.get(call.peerId);
        if (conn) sendSecure(conn, { type: 'audio-call-end', callId: call.callId, reason });
      }
      if (call?.pc) { try { call.pc.onicecandidate = null; call.pc.ontrack = null; call.pc.close(); } catch (_) {} }
      if (call?.localStream) call.localStream.getTracks().forEach(t => t.stop());
      const audio = document.getElementById('n2RemoteAudio');
      if (audio) { audio.pause(); audio.srcObject = null; }
      n2AudioCall = null;
      n2SetCallOverlay(false);
      const header = document.getElementById('n2HeaderCallBtn');
      if (header) header.disabled = activePeerId === 'system' || !activeConnections.has(activePeerId);
      renderZijbalkTabs();
    }

    async function n2CreateAudioPeerConnection(call) {
      if (call.pc) return call.pc;
      const pc = new RTCPeerConnection(N2_AUDIO_RTC_CONFIG);
      call.pc = pc;
      pc.onicecandidate = (event) => {
        if (event.candidate) {
          const conn = activeConnections.get(call.peerId);
          if (conn) sendSecure(conn, { type: 'audio-call-ice', callId: call.callId, candidate: event.candidate });
        }
      };
      pc.onconnectionstatechange = () => {
        if (!n2AudioCall || n2AudioCall.callId !== call.callId) return;
        if (pc.connectionState === 'connected') {
          n2SetCallOverlay(true, call.peerId, 'Connected', `<button class="n2-call-action mute" type="button" onclick="toggleN2AudioMute()" id="n2MuteBtn">🎙️ Dempen</button><button class="n2-call-action end" type="button" onclick="n2EndAudioCall(true, 'Call ended')">📵 Ophangen</button>`);
        } else if (['failed','disconnected','closed'].includes(pc.connectionState)) {
          n2EndAudioCall(false, 'Connection lost');
          showToast('Audio call disconnected.');
        }
      };
      pc.ontrack = (event) => {
        const audio = document.getElementById('n2RemoteAudio');
        if (audio) { audio.srcObject = event.streams[0]; audio.play().catch(() => {}); }
      };
      if (call.localStream) call.localStream.getTracks().forEach(track => pc.addTrack(track, call.localStream));
      return pc;
    }

    async function n2FlushQueuedIce(call) {
      const queued = n2AudioIceQueues.get(call.callId) || [];
      n2AudioIceQueues.delete(call.callId);
      for (const candidate of queued) {
        try { await call.pc.addIceCandidate(candidate); } catch (_) {}
      }
    }

    async function startAudioCall(peerId, event) {
      if (event) event.stopPropagation();
      if (!peerId || peerId === 'system' || peerId === currentFullID) return;
      if (!isLoggedIn) { showToast('Log eerst in om te bellen.'); return; }
      if (n2AudioCall) { showToast('An audio call is already active.'); return; }
      if (!window.RTCPeerConnection || !navigator.mediaDevices?.getUserMedia) {
        showToast('Audio calling is not supported by this browser.'); return;
      }
      if (!activeConnections.has(peerId)) {
        n2PendingAudioCalls.set(peerId, true);
        connectToRemotePeerId(peerId, false);
        showToast('Connecting to ' + escapeHTML(peerId) + ' om te bellen…');
        return;
      }
      const conn = activeConnections.get(peerId);
      const callId = 'call-' + crypto.randomUUID();
      try {
        const stream = await navigator.mediaDevices.getUserMedia({ audio: true, video: false });
        n2AudioCall = { callId, peerId, role: 'caller', localStream: stream, pc: null, muted: false };
        n2SetCallOverlay(true, peerId, 'Starting call…', `<button class="n2-call-action end" type="button" onclick="n2EndAudioCall(true, 'Call cancelled')">📵 Annuleren</button>`);
        sendSecure(conn, { type: 'audio-call-invite', callId });
        n2SetCallOverlay(true, peerId, 'Overgaan…', `<button class="n2-call-action end" type="button" onclick="n2EndAudioCall(true, 'Call cancelled')">📵 Annuleren</button>`);
      } catch (e) {
        n2AudioCall = null;
        showToast('Microphone access denied. Check browser permissions.');
      }
    }

    function startAudioCallFromActiveChat() {
      if (activePeerId && activePeerId !== 'system') startAudioCall(activePeerId);
    }

    async function n2AcceptAudioCall(peerId, callId) {
      const pending = n2PendingAudioCalls.get(peerId);
      if (!pending || pending.callId !== callId) return;
      n2StopRingtone();
      if(n2MissedCallTimers.has(callId)){clearTimeout(n2MissedCallTimers.get(callId));n2MissedCallTimers.delete(callId);}
      try {
        const stream = await navigator.mediaDevices.getUserMedia({ audio: true, video: false });
        n2AudioCall = { callId, peerId, role: 'callee', localStream: stream, pc: null, muted: false };
        const conn = activeConnections.get(peerId);
        if (!conn) throw new Error('NO_CONNECTION');
        n2PendingAudioCalls.delete(peerId);
        sendSecure(conn, { type: 'audio-call-answer', callId, accepted: true });
        n2SetCallOverlay(true, peerId, 'Verbinden…', `<button class="n2-call-action mute" type="button" onclick="toggleN2AudioMute()" id="n2MuteBtn">🎙️ Dempen</button><button class="n2-call-action end" type="button" onclick="n2EndAudioCall(true, 'Call ended')">📵 Ophangen</button>`);
        await n2CreateAudioPeerConnection(n2AudioCall);
      } catch (e) {
        const conn = activeConnections.get(peerId);
        if (conn) sendSecure(conn, { type: 'audio-call-answer', callId, accepted: false });
        n2PendingAudioCalls.delete(peerId);
        n2StopRingtone();
        n2SetCallOverlay(false);
        showToast('Microphone access was denied or the audio call could not start.');
      }
    }

    function n2RejectAudioCall(peerId, callId) {
      const pending = n2PendingAudioCalls.get(peerId);
      if (!pending || pending.callId !== callId) return;
      const conn = activeConnections.get(peerId);
      if (conn) sendSecure(conn, { type: 'audio-call-answer', callId, accepted: false });
      if(n2MissedCallTimers.has(callId)){clearTimeout(n2MissedCallTimers.get(callId));n2MissedCallTimers.delete(callId);}
      n2PendingAudioCalls.delete(peerId);
      n2StopRingtone();
      n2SetCallOverlay(false);
    }

    async function n2HandleAudioCallSignal(conn, data) {
      const peerId = conn.peer;
      if (data.type === 'audio-call-invite') {
        if (n2AudioCall || n2PendingAudioCalls.has(peerId)) {
          sendSecure(conn, { type: 'audio-call-answer', callId: data.callId, accepted: false, busy: true });
          return;
        }
        n2PendingAudioCalls.set(peerId, { callId: data.callId, receivedAt: Date.now() });
        if(n2MissedCallTimers.has(data.callId)) clearTimeout(n2MissedCallTimers.get(data.callId));
        n2MissedCallTimers.set(data.callId,setTimeout(()=>{
          const pending=n2PendingAudioCalls.get(peerId);
          if(pending?.callId===data.callId){
            n2RecordMissedCall(peerId,data.callId);
            const c=activeConnections.get(peerId); if(c) sendSecure(c,{type:'audio-call-answer',callId:data.callId,accepted:false,missed:true});
            n2PendingAudioCalls.delete(peerId); n2StopRingtone(); n2SetCallOverlay(false);
          }
          n2MissedCallTimers.delete(data.callId);
        },30000));
        n2SetCallOverlay(true, peerId, 'Incoming audio call…', `<button class="n2-call-action accept" type="button" onclick="n2AcceptAudioCall(decodeURIComponent('${encodeURIComponent(peerId)}'),decodeURIComponent('${encodeURIComponent(data.callId)}'))">📞 Opnemen</button><button class="n2-call-action reject" type="button" onclick="n2RejectAudioCall(decodeURIComponent('${encodeURIComponent(peerId)}'),decodeURIComponent('${encodeURIComponent(data.callId)}'))">📵 Weigeren</button>`);
        n2StartRingtone();
      } else if (data.type === 'audio-call-answer') {
        if (!n2AudioCall || n2AudioCall.callId !== data.callId || n2AudioCall.peerId !== peerId) return;
        if (!data.accepted) {
          n2EndAudioCall(false);
          showToast(data.busy ? 'Contact is currently busy.' : 'Audio call declined.');
          return;
        }
        n2SetCallOverlay(true, peerId, 'Verbinden…', `<button class="n2-call-action mute" type="button" onclick="toggleN2AudioMute()" id="n2MuteBtn">🎙️ Dempen</button><button class="n2-call-action end" type="button" onclick="n2EndAudioCall(true, 'Call ended')">📵 Ophangen</button>`);
        const pc = await n2CreateAudioPeerConnection(n2AudioCall);
        const offer = await pc.createOffer();
        await pc.setLocalDescription(offer);
        sendSecure(conn, { type: 'audio-call-offer', callId: data.callId, sdp: pc.localDescription });
      } else if (data.type === 'audio-call-offer') {
        if (!n2AudioCall || n2AudioCall.callId !== data.callId || n2AudioCall.peerId !== peerId) return;
        const pc = await n2CreateAudioPeerConnection(n2AudioCall);
        await pc.setRemoteDescription(data.sdp);
        await n2FlushQueuedIce(n2AudioCall);
        const answer = await pc.createAnswer();
        await pc.setLocalDescription(answer);
        sendSecure(conn, { type: 'audio-call-answer-sdp', callId: data.callId, sdp: pc.localDescription });
      } else if (data.type === 'audio-call-answer-sdp') {
        if (!n2AudioCall || n2AudioCall.callId !== data.callId || n2AudioCall.peerId !== peerId) return;
        await n2AudioCall.pc.setRemoteDescription(data.sdp);
        await n2FlushQueuedIce(n2AudioCall);
      } else if (data.type === 'audio-call-ice') {
        if (!n2AudioCall || n2AudioCall.callId !== data.callId || n2AudioCall.peerId !== peerId || !n2AudioCall.pc || !n2AudioCall.pc.remoteDescription) {
          const q = n2AudioIceQueues.get(data.callId) || []; q.push(data.candidate); n2AudioIceQueues.set(data.callId, q); return;
        }
        try { await n2AudioCall.pc.addIceCandidate(data.candidate); } catch (_) {}
      } else if (data.type === 'audio-call-end') {
        if (n2AudioCall?.callId === data.callId) n2EndAudioCall(false);
        if (n2PendingAudioCalls.get(peerId)?.callId === data.callId) {
          if(!data.reason || !/declin|cancel|ended/i.test(String(data.reason))) n2RecordMissedCall(peerId,data.callId);
          if(n2MissedCallTimers.has(data.callId)){clearTimeout(n2MissedCallTimers.get(data.callId));n2MissedCallTimers.delete(data.callId);}
          n2PendingAudioCalls.delete(peerId); n2StopRingtone(); n2SetCallOverlay(false);
        }
        showToast(data.reason || 'Audio call beëindigd.');
      }
    }

    function toggleN2AudioMute() {
      if (!n2AudioCall?.localStream) return;
      n2AudioCall.muted = !n2AudioCall.muted;
      n2AudioCall.localStream.getAudioTracks().forEach(track => track.enabled = !n2AudioCall.muted);
      const btn = document.getElementById('n2MuteBtn');
      if (btn) btn.textContent = n2AudioCall.muted ? '🔇 Microphone on' : '🎙️ Mute';
    }

    function setupConnection(conn) {
      conn.on('error', (err) => {
        console.warn('N² data-verbinding fout:', conn.peer, err?.type || err);
        const messages = {
          'peer-unavailable': 'De andere node is niet bereikbaar. Controleer het volledige ID en of die node online is.',
          'network': 'Netwerkfout tijdens verbinden. Probeer opnieuw.',
          'webrtc': 'WebRTC-verbinding mislukt; controleer TURN-instellingen of netwerk/firewall.',
          'server-error': 'PeerJS-signalingserverfout tijdens verbinden.'
        };
        showToast(messages[err?.type] || ('Verbinden mislukt: ' + (err?.type || 'onbekende fout')));
      });
      conn.on('close', () => {
        if (activeConnections.get(conn.peer) === conn) {
          activeConnections.delete(conn.peer);
          secureSessions.delete(conn.peer);
          peerStatuses.set(conn.peer, 'Disconnected');
          renderZijbalkTabs();
        }
      });
      conn.on('open', () => {
        activeConnections.set(conn.peer, conn);
        addPeerToSavedList(conn.peer);
        ensurePeerWindowExists(conn.peer);
        
        peerStatuses.set(conn.peer, 'Connected');
        
        flushMessageQueue(conn.peer, conn);
        n2SecureConnectionStarted(conn);

        renderZijbalkTabs();
        showToast(`Verbonden to node: ${escapeHTML(conn.peer)}`);

        sendSecure(conn, { type: 'status', status: currentStatus });
        sendSecure(conn, {
          type: 'profile',
          profile: {
            name: (document.getElementById('nameTagInput')?.value || '').trim() || currentFullID,
            nodeId: currentFullID,
            photo: localStorage.getItem(SAVED_PROFILE_PHOTO_KEY) || '',
            status: getCurrentCustomProfileStatus()
          }
        });
        n2SendListeningStatusTo(conn);
        if (n2PendingAudioCalls.get(conn.peer)) {
          n2PendingAudioCalls.delete(conn.peer);
          setTimeout(() => startAudioCall(conn.peer), 0);
        }
      });

      conn.on('data', async (data) => {
        data = await receiveSecure(conn, data);
        if (data == null) return;
        if (data && typeof data.type === 'string' && data.type.startsWith('audio-call-')) {
          await n2HandleAudioCallSignal(conn, data);
          return;
        }
        if (data && data.type === 'n2-game') {
          n2GameReceivePacket(conn, data);
          return;
        }
        if (data && data.type === 'file-chunk') {
          await handleIncomingFileChunk(conn.peer, data.transferId, data.chunk);
          return;
        }

        if (data.type === 'profile') {
          updatePeerProfile(conn.peer, data.profile);
        } else if (data.type === 'group-invite') {
          if (!data.groupId || !Array.isArray(data.members) || data.members.length > 64 || !data.members.includes(currentFullID)) return;
          n2EnsureGroup({...data,members:data.members.map(String).filter(id=>id.length<=200)});renderZijbalkTabs();showToast(`Groepschat '${escapeHTML(data.groupName)}' ontvangen.`);
        } else if (data.type === 'chat') {
          const group=data.groupId?n2EnsureGroup(data):null;
          const targetWindow=group?group.id:((data.channel === 'system' || data.tag === 'CWL+ Broadcast')?'system':conn.peer);
          if(group)renderZijbalkTabs();
          renderMessageUI(targetWindow,data.text,'incoming',conn.peer,data.tag,true,false,data.msgId,conn.peer);
          playAudioPreset(currentMsgSound);
        } else if (data.type === 'peertube') {
          const safeEmbedUrl = parsePeerTubeUrl(data.embedUrl);
          if (!safeEmbedUrl) return;
          const videoTarget = data.groupId || (data.channel === 'system' ? 'system' : conn.peer);
          renderPeerTubeCardUI(videoTarget, {
            embedUrl: safeEmbedUrl,
            direction: 'incoming',
            sender: conn.peer,
            senderId: conn.peer,
            isBuffered: false
          }, true, data.msgId);
          playAudioPreset(currentMsgSound);
        } else if (data.type === 'nudge') {
          const group = data.groupId ? n2EnsureGroup(data) : null;
          const targetWindow = group ? group.id : conn.peer;
          if (group) renderZijbalkTabs();
          triggerNudgeUI(targetWindow, n2GetPeerDisplayName(data.sender || conn.peer), !!group);
          playAudioPreset(currentNudgeSound);
        } else if (data.type === 'status') {
          peerStatuses.set(conn.peer, data.status);
          renderZijbalkTabs();
        } else if (data.type === 'audio-listening-status') {
          peerListening.set(conn.peer, {playing:!!data.playing, name:String(data.name||'')});
          renderZijbalkTabs();
          if (activePeerId === conn.peer) {
            const live = peerListening.get(conn.peer);
            const base = peerStatuses.get(conn.peer) || 'Connected';
            const label = document.getElementById('p2pStatusLabel');
            if (label) label.innerText = live?.playing && live?.name ? `🎵 Luistert: ${live.name}` : base;
          }
        } else if (data.type === 'file-header') {
          initIncomingFileTransfer(conn.peer, data);
        } else if (data.type === 'wb-draw') {
          drawSegment(data.x1, data.y1, data.x2, data.y2, data.color, data.size, data.erasing, data.gStart || null, data.gEnd || null);
        } else if (data.type === 'wb-clear') {
          clearWhiteboard(false);
        }
      });

      conn.on('close', () => {
        if (n2AudioCall?.peerId === conn.peer) n2EndAudioCall(false, 'Connection lost');
        if (n2PendingAudioCalls.has(conn.peer)) {
          const pending=n2PendingAudioCalls.get(conn.peer); if(pending?.callId) n2RecordMissedCall(conn.peer,pending.callId);
          if(pending?.callId && n2MissedCallTimers.has(pending.callId)){clearTimeout(n2MissedCallTimers.get(pending.callId));n2MissedCallTimers.delete(pending.callId);}
          n2PendingAudioCalls.delete(conn.peer); n2StopRingtone(); n2SetCallOverlay(false);
        }
        secureSessions.delete(conn.peer);
        securePendingQueues.delete(conn.peer);
        activeConnections.delete(conn.peer);
        peerStatuses.set(conn.peer, 'Offline (saved)');
        peerListening.delete(conn.peer);
        renderZijbalkTabs();
        if (activePeerId === conn.peer) {
          const label = document.getElementById('p2pStatusLabel');
          if (label) label.innerText = 'Offline (saved)';
        }
        showToast(`Verbinding met ${escapeHTML(conn.peer)} verbroken.`);
      });
    }

    // ==========================================
    // N² LOCAL AUDIO PLAYLIST (no network synchronization)
    // ==========================================
    function n2PlaylistCloneMeta() {
      return n2AudioPlaylist.map(t => ({ id:t.id, name:t.name, size:t.size, type:t.type, addedBy:t.addedBy, addedAt:t.addedAt }));
    }
    function n2OpenAudioPlaylistDB(){
      if(n2AudioPlaylistDBPromise) return n2AudioPlaylistDBPromise;
      n2AudioPlaylistDBPromise=new Promise((resolve,reject)=>{
        if(!('indexedDB' in window)){resolve(null);return;}
        const req=indexedDB.open(N2_AUDIO_PLAYLIST_DB,2);
        req.onupgradeneeded=()=>{
          const db=req.result;
          if(!db.objectStoreNames.contains('tracks')) db.createObjectStore('tracks',{keyPath:'id'});
          if(!db.objectStoreNames.contains('playlistMeta')) db.createObjectStore('playlistMeta',{keyPath:'id'});
        };
        req.onsuccess=()=>resolve(req.result); req.onerror=()=>reject(req.error);
      }).catch(e=>{console.warn('N² audio local store:',e);return null;});
      return n2AudioPlaylistDBPromise;
    }
    async function n2StoreAudioPlaylistBlob(id,blob){
      const db=await n2OpenAudioPlaylistDB(); if(!db||!blob)return;
      await new Promise((resolve,reject)=>{const tx=db.transaction('tracks','readwrite');tx.objectStore('tracks').put({id,blob});tx.oncomplete=resolve;tx.onerror=()=>reject(tx.error);});
    }
    async function n2LoadAudioPlaylistBlob(id){
      const db=await n2OpenAudioPlaylistDB(); if(!db)return null;
