    function initN2FloatingPanelDrag(panelId, handleId, storageKey){
      const panel=document.getElementById(panelId);
      const handle=document.getElementById(handleId);
      if(!panel||!handle||handle.dataset.dragReady==='true') return;
      handle.dataset.dragReady='true';
      let dragging=false,offsetX=0,offsetY=0;
      handle.addEventListener('pointerdown',event=>{
        if(window.innerWidth>768 || panel.hidden || event.target.closest('button,input,select,textarea,a')) return;
        const r=panel.getBoundingClientRect();
        panel.style.transform='none'; panel.style.left=`${r.left}px`; panel.style.top=`${r.top}px`; panel.style.right='auto';
        offsetX=event.clientX-r.left; offsetY=event.clientY-r.top; dragging=true;
        panel.classList.add('n2-floating-dragging'); handle.setPointerCapture?.(event.pointerId); event.preventDefault();
      });
      handle.addEventListener('pointermove',event=>{
        if(!dragging) return;
        const r=panel.getBoundingClientRect();
        const maxL=Math.max(6,innerWidth-r.width-6),maxT=Math.max(6,innerHeight-r.height-6);
        const left=Math.max(6,Math.min(event.clientX-offsetX,maxL));
        const top=Math.max(6,Math.min(event.clientY-offsetY,maxT));
        panel.style.left=`${left}px`; panel.style.top=`${top}px`; event.preventDefault();
      });
      const stop=event=>{
        if(!dragging) return; dragging=false; panel.classList.remove('n2-floating-dragging');
        try{handle.releasePointerCapture?.(event.pointerId);}catch(e){}
        try{localStorage.setItem(storageKey,JSON.stringify({left:panel.style.left,top:panel.style.top}));}catch(e){}
      };
      handle.addEventListener('pointerup',stop); handle.addEventListener('pointercancel',stop);
      window.addEventListener('blur',()=>{dragging=false;panel.classList.remove('n2-floating-dragging');});
      try{
        const saved=JSON.parse(localStorage.getItem(storageKey)||'null');
        if(saved?.left&&saved?.top&&window.innerWidth<=768){
          panel.style.transform='none'; panel.style.left=saved.left; panel.style.top=saved.top; panel.style.right='auto';
        }
      }catch(e){}
    }

