          n2UpdateBatteryStatus(battery);
          battery.addEventListener('levelchange', () => n2UpdateBatteryStatus(battery));
          battery.addEventListener('chargingchange', () => n2UpdateBatteryStatus(battery));
        } catch (_) {
          n2UpdateBatteryStatus(null);
        }
      } else {
        n2UpdateBatteryStatus(null);
      }

      window.addEventListener('online', () => {
        n2UpdateOnlineStatus();
        n2UpdateNetworkStatus();
      });
      window.addEventListener('offline', () => {
        n2UpdateOnlineStatus();
        n2UpdateNetworkStatus();
      });

      const connection = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
      if (connection && typeof connection.addEventListener === 'function') {
        connection.addEventListener('change', n2UpdateNetworkStatus);
      }
    }

