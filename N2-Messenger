      n2GameName = '';
      n2GameSetStatus('Game gestopt.');
    }
    function n2GameLoadHtmlText(html, fileName, autoStart) {
      if (typeof html !== 'string' || html.length > N2_GAME_MAX_HTML_BYTES) { n2GameSetStatus('HTML-game is ongeldig of te groot.'); return; }
      try {
          if (!/<html[\s>]/i.test(html) && !/<body[\s>]/i.test(html)) throw new Error('Dit lijkt geen HTML-document.');
          n2GameStop();
          n2GameName = String(fileName || 'N2-game.html').slice(0,180);
          n2GameHtmlSource = html;
          n2GameSessionId = (crypto.randomUUID ? crypto.randomUUID() : `${Date.now()}-${Math.random().toString(36).slice(2)}`);
          n2GameSeenMessages.clear();
          const bridge = `\n<script>(function(){'use strict';var sessionId=${JSON.stringify(n2GameSessionId)};var seq=0;window.N2Game={version:1,sessionId:sessionId,send:function(data){try{parent.postMessage({source:'N2_GAME_BRIDGE',version:1,sessionId:sessionId,seq:++seq,data:data},'*');return true;}catch(e){return false;}},onMessage:function(fn){if(typeof fn!=='function')return function(){};var h=function(e){var d=e.data;if(e.source===parent&&d&&d.source==='N2_GAME_MESSAGE'&&d.version===1&&d.sessionId===sessionId){try{fn(d.data,d.from||null);}catch(err){console.error('N2Game handler error',err);}}};addEventListener('message',h);return function(){removeEventListener('message',h);};},getNodeId:function(){return null;}};parent.postMessage({source:'N2_GAME_BRIDGE_READY',version:1,sessionId:sessionId},'*');})();<\/script>\n`;
          let safeHtml = html;
          // Belangrijk: de game controleert window.N2Game al tijdens het uitvoeren van zijn hoofdscript.
          // Daarom moet de bridge vóór game-scripts worden ingevoegd, niet vlak vóór </body>.
          if (/<\/head\s*>/i.test(safeHtml)) safeHtml = safeHtml.replace(/<\/head\s*>/i, bridge + '</head>');
          else if (/<script\b/i.test(safeHtml)) safeHtml = safeHtml.replace(/<script\b/i, bridge + '<script');
          else if (/<\/body\s*>/i.test(safeHtml)) safeHtml = safeHtml.replace(/<\/body\s*>/i, bridge + '</body>');
          else if (/<\/html\s*>/i.test(safeHtml)) safeHtml = safeHtml.replace(/<\/html\s*>/i, bridge + '</html>');
          else safeHtml += bridge;
          n2GameObjectUrl = URL.createObjectURL(new Blob([safeHtml], {type:'text/html;charset=utf-8'}));
          const stage = document.getElementById('n2GameStage'); stage.innerHTML = '';
          const frame = document.createElement('iframe'); frame.className = 'n2-game-frame'; frame.title = `Game: ${n2GameName}`;
          frame.setAttribute('sandbox','allow-scripts allow-forms allow-pointer-lock'); frame.setAttribute('allow','fullscreen; gamepad'); frame.src = n2GameObjectUrl;
          stage.appendChild(frame); n2GameFrame = frame;
          n2GameSetStatus(`Automatisch geladen: ${n2GameName} · ${activeConnections.size} node(s) verbonden`);
          n2GameBroadcast({kind:'game-loaded', gameName:n2GameName, sessionId:n2GameSessionId});
          if (autoStart) { const targetSession=n2GameSessionId; setTimeout(() => { if (n2GameFrame?.contentWindow && n2GameSessionId===targetSession) n2GameFrame.contentWindow.postMessage({source:'N2_GAME_MESSAGE',version:1,sessionId:targetSession,data:{type:'jumping-madness-start',game:'N2_JUMPING_MADNESS'},from:'network'}, '*'); }, 800); }
      } catch (e) { n2GameSetStatus('Laden mislukt: ' + (e.message || 'onbekende fout')); }
    }
    function n2GameSendHtmlToPeer(peerId) {
      if (!n2GameHtmlSource) return;
      const transferId = `${Date.now()}-${Math.random().toString(36).slice(2,10)}`;
      const chunkSize = 7000, chunks = Math.ceil(n2GameHtmlSource.length / chunkSize);
      n2GameBroadcast({kind:'game-file-meta', transferId, chunks, gameName:n2GameName}, peerId);
      for (let i=0; i<chunks; i++) n2GameBroadcast({kind:'game-file-chunk', transferId, index:i, text:n2GameHtmlSource.slice(i*chunkSize,(i+1)*chunkSize)}, peerId);
    }
    function n2GameLoadHtmlFile(file) {
      if (!file) return;
      if (!/\.html?$/i.test(file.name) && file.type !== 'text/html') { showToast('Kies een .html- of .htm-bestand.'); return; }
      if (file.size > N2_GAME_MAX_HTML_BYTES) { showToast('HTML-game is te groot (maximaal 4 MB).'); return; }
      const reader = new FileReader();
      reader.onerror = () => n2GameSetStatus('Het HTML-bestand kon niet worden gelezen.');
      reader.onload = () => n2GameLoadHtmlText(String(reader.result || ''), file.name, false);
      reader.readAsText(file);
    }
    document.getElementById('n2GameFileInput')?.addEventListener('change', function(e) {
      n2GameLoadHtmlFile(e.target.files && e.target.files[0]); e.target.value = '';
    });
    function n2GameBroadcast(data, onlyPeerId) {
      if (!data || typeof data !== 'object') return;
      const packet = {type:'n2-game', gameName:n2GameName || '', sessionId:n2GameSessionId || '', from:currentFullID, msgId:`${currentFullID}:${Date.now()}:${++n2GameMessageSeq}`, data};
      let sent = 0;
      if (onlyPeerId) {
        const conn = activeConnections.get(onlyPeerId);
        if (conn) { sendSecure(conn, packet); sent++; }
      } else {
        activeConnections.forEach(conn => { if (conn && conn.open) { sendSecure(conn, packet); sent++; } });
      }
      return sent;
    }
    function n2GameSendPing() {
      const sent = n2GameBroadcast({kind:'ping', at:Date.now()});
      n2GameSetStatus(`Verbindingstest verstuurd naar ${sent || 0} verbonden node(s).`);
      if (!sent) showToast('Er zijn geen verbonden nodes om de test naartoe te sturen.');
    }
    function n2GameReceivePacket(conn, packet) {
      if (!packet || typeof packet !== 'object' || !packet.data || typeof packet.data !== 'object') return;
      if (typeof packet.msgId === 'string') {
        if (n2GameSeenMessages.has(packet.msgId)) return;
        n2GameSeenMessages.add(packet.msgId);
        if (n2GameSeenMessages.size > 500) n2GameSeenMessages.delete(n2GameSeenMessages.values().next().value);
      }
      const d = packet.data;
      if (d.kind === 'game-file-meta') {
        if (!Number.isFinite(d.chunks) || d.chunks < 1 || d.chunks > 600 || !d.transferId) return;
        n2GameTransfers.set(d.transferId, {name:String(d.gameName || 'N2-game.html').slice(0,180), chunks:d.chunks, parts:new Array(d.chunks), received:0, from:conn.peer});
        n2GameSetStatus(`${conn.peer} stuurt de game automatisch door…`); return;
      } else if (d.kind === 'game-file-chunk') {
        const tr=n2GameTransfers.get(d.transferId);
        if (!tr || !Number.isInteger(d.index) || d.index<0 || d.index>=tr.chunks || typeof d.text!=='string') return;
        if (tr.parts[d.index]===undefined) { tr.parts[d.index]=d.text; tr.received++; }
        if (tr.received===tr.chunks) {
          const html=tr.parts.join(''); n2GameTransfers.delete(d.transferId);
          if (html.length > N2_GAME_MAX_HTML_BYTES || !/<html[\s>]/i.test(html)) { n2GameSetStatus('Automatisch laden mislukt: ongeldig of te groot HTML-bestand.'); return; }
          n2GameLoadHtmlText(html, tr.name, true);
        }
        return;
      }
      if (d.kind === 'ping') {
        sendSecure(conn, {type:'n2-game', gameName:n2GameName || '', sessionId:n2GameSessionId || '', from:currentFullID, msgId:`${currentFullID}:${Date.now()}:${++n2GameMessageSeq}`, data:{kind:'pong', at:d.at}});
        n2GameSetStatus(`Verbindingstest ontvangen van ${conn.peer}; antwoord verzonden.`);
      } else if (d.kind === 'pong') {
        n2GameSetStatus(`Verbinding met ${conn.peer} werkt via E2E-versleutelde P2P.`);
      } else if (d.kind === 'game-loaded' || d.kind === 'start-request') {
        n2GameSetStatus(`${conn.peer} ${d.kind === 'game-loaded' ? 'heeft een game geladen' : 'start multiplayer'}${packet.gameName ? ': ' + packet.gameName : ''}.`);
        if (d.kind === 'start-request') {
          if (n2GameHtmlSource) n2GameSendHtmlToPeer(conn.peer);
          else n2GameSetStatus(`${conn.peer} startte een game, maar deze node heeft geen gamebestand om door te sturen.`);
        }
      } else if (d.kind === 'ready') {
        n2GameSetStatus(`${conn.peer} is klaar om te spelen.`);
      } else if (d.kind === 'game-data' || d.kind === 'game-event' || d.kind === 'state') {
        if (n2GameFrame?.contentWindow) {
          n2GameFrame.contentWindow.postMessage({source:'N2_GAME_MESSAGE',version:1,sessionId:n2GameSessionId,data:(d.kind==='game-data' ? d.payload : d),from:conn.peer}, '*');
        }
      }
    }
    window.addEventListener('message', function(event) {
      const msg = event.data;
      if (!n2GameFrame || event.source !== n2GameFrame.contentWindow || !msg || typeof msg !== 'object') return;
      if (msg.source === 'N2_GAME_BRIDGE_READY' && msg.sessionId === n2GameSessionId) {
        n2GameSetStatus(`Game klaar: ${n2GameName}. Deel multiplayer-uitnodiging met verbonden nodes.`);
      } else if (msg.source === 'N2_GAME_BRIDGE' && msg.version === 1 && msg.sessionId === n2GameSessionId) {
        let serialized = '';
        try { serialized = JSON.stringify(msg.data); } catch (_) { return; }
        if (serialized.length > 12000) { n2GameSetStatus('Gamebericht geweigerd: maximaal 12 KB per bericht.'); return; }
        if (msg.data && msg.data.type === 'jumping-madness-start' && msg.data.game === 'N2_JUMPING_MADNESS') {
          n2GameBroadcast({kind:'start-request', gameName:n2GameName});
        }
        n2GameBroadcast({kind:'game-data', payload:msg.data, gameName:n2GameName});
      }
    });

    // ==========================================
    // EXTRA CHAT / NUDGE SOUNDS
    // ==========================================

    function playExtraSoundPreset(key, now, masterVolume) {
      const presets = {
        soft_ping:      { notes:[659.25], wave:'sine',     spacing:0,    duration:.45, gain:.22 },
        double_ping:    { notes:[659.25, 880], wave:'sine', spacing:.10, duration:.32, gain:.20 },
        sonar:          { notes:[220, 440], wave:'sine', spacing:.18, duration:.65, gain:.24 },
        neon_pulse:     { notes:[880, 1174.66, 880], wave:'triangle', spacing:.07, duration:.22, gain:.17 },
        arcade:         { notes:[1046.5, 1318.51, 1567.98], wave:'square', spacing:.06, duration:.12, gain:.13 },
        crystal:        { notes:[783.99, 987.77, 1174.66, 1567.98], wave:'sine', spacing:.07, duration:.55, gain:.16 },
        cosmic:         { notes:[196, 293.66, 392, 587.33], wave:'triangle', spacing:.12, duration:.85, gain:.14 },
        futuristic:     { notes:[330, 660, 990, 1320], wave:'sawtooth', spacing:.065, duration:.18, gain:.12 },
        heartbeat:      { notes:[90, 90], wave:'sine', spacing:.16, duration:.18, gain:.30 },
        electric:       { notes:[1200, 1800, 2400], wave:'square', spacing:.045, duration:.09, gain:.10 },
        notification:   { notes:[523.25, 659.25, 783.99], wave:'sine', spacing:.09, duration:.42, gain:.20 }
      };

      const preset = presets[key];
      if (!preset) return false;

      preset.notes.forEach((freq, idx) => {
        const startTime = now + idx * preset.spacing;
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = preset.wave;
        osc.frequency.setValueAtTime(freq, startTime);
        gain.gain.setValueAtTime(preset.gain * masterVolume, startTime);
        gain.gain.exponentialRampToValueAtTime(0.001, startTime + preset.duration);
        osc.connect(gain);
        gain.connect(analyser);
        osc.start(startTime);
        osc.stop(startTime + preset.duration);
      });

      return true;
    }

    function triggerNudge() {
      if (n2Groups.has(activePeerId)) {
        const group = n2Groups.get(activePeerId);
        const payload = {
          type: 'nudge',
          groupId: group.id,
          groupName: group.name,
          members: Array.from(group.members),
          sender: currentFullID
        };

        let delivered = false;
        group.members.forEach(id => {
          if (id === currentFullID) return;
          const conn = activeConnections.get(id);
          if (conn) {
            sendSecure(conn, payload);
            delivered = true;
          } else {
            enqueueMessage(id, payload);
          }
        });

        triggerNudgeUI(group.id, 'You', true);
        showToast(delivered ? `💥 Nudge naar groepschat '${escapeHTML(group.name)}' gestuurd.` : `💥 Nudge gebufferd voor groepschat '${escapeHTML(group.name)}'.`);
      } else if (activePeerId === 'system') {
        activeConnections.forEach(conn => sendSecure(conn, { type: 'nudge', sender: currentFullID }));
        triggerNudgeUI('system', 'You');
      } else {
        const conn = activeConnections.get(activePeerId);
        if (conn) {
          sendSecure(conn, { type: 'nudge', sender: currentFullID });
          triggerNudgeUI(activePeerId, 'You');
        } else {
          enqueueMessage(activePeerId, { type: 'nudge', sender: currentFullID });
          triggerNudgeUI(activePeerId, 'Jij (gebufferd)');
        }
      }
      playAudioPreset(currentNudgeSound);
    }

    function triggerNudgeUI(targetWindowPeerId, sender) {
      renderNudgeUI(targetWindowPeerId, sender, true);
      const win = document.getElementById('messengerWindow');
      win.classList.remove('nudge-animation');
