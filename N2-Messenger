    function playSymphonicZonsondergang() {
      initAudioContext();
      const ctx = audioCtx;
      const now = ctx.currentTime;

      const volumeSlider = document.getElementById('volumeRange');
      const masterVolume = volumeSlider ? parseFloat(volumeSlider.value) : 0.5;

      const chordFrequencies = [
        [174.61, 261.63, 329.63, 392.00],
        [220.00, 261.63, 329.63, 440.00],
        [196.00, 246.94, 293.66, 392.00],
        [174.61, 220.00, 261.63, 329.63]
      ];

      chordFrequencies.forEach((chord, chordIndex) => {
        const startTime = now + (chordIndex * 7.5);
        
        chord.forEach(freq => {
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(freq, startTime);
          
          gain.gain.setValueAtTime(0, startTime);
          gain.gain.linearRampToValueAtTime(0.08 * masterVolume, startTime + 2.5);
          gain.gain.exponentialRampToValueAtTime(0.0001, startTime + 7.5);
          
          osc.connect(gain);
          if (analyser) {
            gain.connect(analyser);
          } else {
            gain.connect(ctx.destination);
          }
          
          osc.start(startTime);
          osc.stop(startTime + 7.5);
        });
      });
    }

