    // ==========================================
    // AUDIO ENGINE & VISUALIZER (AUDIO SECTION)
    // ==========================================

    function initAudioContext() {
      if (!audioCtx) {
        const AudioContextClass = window.AudioContext || window.webkitAudioContext;
        audioCtx = new AudioContextClass();
        analyser = audioCtx.createAnalyser();
        analyser.fftSize = 512;
        analyser.connect(audioCtx.destination);
        drawVisualizer();
      }
      if (audioCtx.state === 'suspended') audioCtx.resume();
    }

    function playN2Tone(type) {
      initAudioContext();
      const volumeSlider = document.getElementById('volumeRange');
      const masterVolume = volumeSlider ? parseFloat(volumeSlider.value) : 0.5;
      const now = audioCtx.currentTime;

      const noteDuration = 0.18;
      const stepInterval = 0.12;

      const highFreq = 659.25;
      const lowFreq  = 329.63;

      const notes = (type === 'login') 
        ? [highFreq, lowFreq, highFreq, highFreq]
        : [lowFreq, highFreq, lowFreq, lowFreq];

      notes.forEach((freq, idx) => {
        const startTime = now + (idx * stepInterval);
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();

        osc.type = 'sine';
        osc.frequency.setValueAtTime(freq, startTime);

        gain.gain.setValueAtTime(0.3 * masterVolume, startTime);
        gain.gain.exponentialRampToValueAtTime(0.001, startTime + noteDuration);

        osc.connect(gain);
        gain.connect(analyser);

        osc.start(startTime);
        osc.stop(startTime + noteDuration);
      });
    }

    function playAudioPreset(key) {
      initAudioContext();
      const volumeSlider = document.getElementById('volumeRange');
      const masterVolume = volumeSlider ? parseFloat(volumeSlider.value) : 0.5;
      const now = audioCtx.currentTime;

      if (key === 'silent') return;

      if (key === 'symphonic') {
        playSymphonicZonsondergang();
        return;
      }

      if (key === 'sine_08' || key === 'sine_15') {
        const isSlow = key === 'sine_08';
        const duration = isSlow ? 0.5 : 0.2;
        const notes = [440, 554.37, 659.25];
        
        notes.forEach((freq, idx) => {
          const startTime = now + (idx * (isSlow ? 0.12 : 0.05));
          const osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(freq, startTime);
          gain.gain.setValueAtTime(0.25 * masterVolume, startTime);
          gain.gain.exponentialRampToValueAtTime(0.001, startTime + duration);
          osc.connect(gain);
          gain.connect(analyser);
          osc.start(startTime);
          osc.stop(startTime + duration);
        });
        return;
      }

      if (playExtraSoundPreset(key, now, masterVolume)) {
        return;
      }

      if (key === 'classic') {
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = 'sawtooth';
        osc.frequency.setValueAtTime(175, now);
        osc.frequency.exponentialRampToValueAtTime(65, now + 0.65);
        gain.gain.setValueAtTime(0.38 * masterVolume, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.65);
        osc.connect(gain);
        gain.connect(analyser);
        osc.start(now);
        osc.stop(now + 0.65);

      } else if (key === 'resonance') {
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(110, now);
        osc.frequency.exponentialRampToValueAtTime(40, now + 0.55);
        gain.gain.setValueAtTime(0.6 * masterVolume, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.55);
        osc.connect(gain);
        gain.connect(analyser);
        osc.start(now);
        osc.stop(now + 0.55);

      } else if (key === 'blip') {
        [2400, 3100].forEach((freq, idx) => {
          const startTime = now + (idx * 0.075);
          const osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();
          osc.type = 'square';
          osc.frequency.setValueAtTime(freq, startTime);
          gain.gain.setValueAtTime(0.18 * masterVolume, startTime);
          gain.gain.exponentialRampToValueAtTime(0.001, startTime + 0.07);
          osc.connect(gain);
          gain.connect(analyser);
          osc.start(startTime);
          osc.stop(startTime + 0.07);
        });

      } else if (key === 'chime') {
        const notes = [523.25, 659.25, 783.99, 1046.50];
        notes.forEach((note, idx) => {
          const startTime = now + (idx * 0.055);
          const osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(note, startTime);
          gain.gain.setValueAtTime(0.22 * masterVolume, startTime);
          gain.gain.exponentialRampToValueAtTime(0.001, startTime + 0.4);
          osc.connect(gain);
          gain.connect(analyser);
          osc.start(startTime);
          osc.stop(startTime + 0.4);
        });

      } else if (key === 'hybrid') {
        const bassOsc = audioCtx.createOscillator();
        const bassGain = audioCtx.createGain();
        bassOsc.type = 'sine';
        bassOsc.frequency.setValueAtTime(120, now);
        bassOsc.frequency.exponentialRampToValueAtTime(45, now + 0.6);
        bassGain.gain.setValueAtTime(0.55 * masterVolume, now);
        bassGain.gain.exponentialRampToValueAtTime(0.001, now + 0.6);
        bassOsc.connect(bassGain);
        bassGain.connect(analyser);
        bassOsc.start(now);
        bassOsc.stop(now + 0.6);

        const notes = [523.25, 659.25, 783.99, 1046.50];
        notes.forEach((note, idx) => {
          const startTime = now + 0.08 + (idx * 0.05);
          const osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(note, startTime);
          gain.gain.setValueAtTime(0.2 * masterVolume, startTime);
          gain.gain.exponentialRampToValueAtTime(0.001, startTime + 0.45);
          osc.connect(gain);
          gain.connect(analyser);
          osc.start(startTime);
          osc.stop(startTime + 0.45);
        });
      }
    }

    function drawVisualizer() {
      requestAnimationFrame(drawVisualizer);
      if (!canvasCtx || !canvas) return;

      const width = canvas.width;
      const height = canvas.height;

      canvasCtx.fillStyle = 'rgba(7, 11, 10, 0.28)';
      canvasCtx.fillRect(0, 0, width, height);

      if (!analyser) {
        canvasCtx.beginPath();
        canvasCtx.strokeStyle = 'rgba(16, 185, 129, 0.25)';
        canvasCtx.lineWidth = 1.5;
        canvasCtx.moveTo(0, height / 2);
        canvasCtx.lineTo(width, height / 2);
        canvasCtx.stroke();
        return;
      }

      const bufferLength = analyser.frequencyBinCount;
      const dataArray = new Uint8Array(bufferLength);
      analyser.getByteTimeDomainData(dataArray);

      canvasCtx.lineWidth = 2;
      canvasCtx.strokeStyle = '#38bdf8';
      canvasCtx.shadowColor = '#0ea5e9';
      canvasCtx.shadowBlur = 6;
      canvasCtx.beginPath();

      const sliceWidth = width / bufferLength;
      let x = 0;

      for (let i = 0; i < bufferLength; i++) {
        const v = dataArray[i] / 128.0;
        const y = (v * height) / 2;
        if (i === 0) canvasCtx.moveTo(x, y);
        else canvasCtx.lineTo(x, y);
        x += sliceWidth;
      }

      canvasCtx.lineTo(width, height / 2);
      canvasCtx.stroke();
    }
  
