      else if (type === 'bluetooth') label = 'Bluetooth';
      else if (type) label = type;
      else label = navigator.onLine ? 'Online' : 'Offline';

      el.textContent = `Netwerk: ${label}${effective ? ' · ' + effective : ''}`;
    }

    async function n2UpdateBluetoothStatus() {
      const el = document.getElementById('n2BluetoothStatus');
      if (!el) return;
      if (!('bluetooth' in navigator)) {
        el.textContent = 'Bluetooth: niet ondersteund';
        return;
      }
      try {
        if (typeof navigator.bluetooth.getAvailability === 'function') {
          const available = await navigator.bluetooth.getAvailability();
          el.textContent = available ? 'Bluetooth: beschikbaar' : 'Bluetooth: uit/niet beschikbaar';
        } else {
          el.textContent = 'Bluetooth: ondersteund';
        }
      } catch (_) {
        el.textContent = 'Bluetooth: onbekend';
      }
    }

    async function n2InitDeviceStatus() {
      n2UpdateOnlineStatus();
