          renderMessageUI(activePeerId, text, 'outgoing', 'Jij', 'Dynamische Handshake');
        } else {
          enqueueMessage(activePeerId, payload);
          renderMessageUI(activePeerId, text, 'outgoing', 'Jij (Gebufferd)', 'Dynamische Handshake', true, true);
