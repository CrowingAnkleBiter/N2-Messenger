    // ==========================================
    // HISTORY STORAGE LOGIC
    // ==========================================

    async function saveMessageToHistoryStorage(peerId, msgObj) {
      try {
        if (!n2VaultUnlocked) return;
        const store = await n2VaultGet(N2_VAULT_HISTORY_KEY, {}) || {};
        if (!store[peerId]) store[peerId] = [];
        store[peerId].push(msgObj);
        await n2VaultSet(N2_VAULT_HISTORY_KEY, store);
        localStorage.removeItem(STORAGE_KEY);
      } catch (e) { console.error("Error securely saving history:", e); }
    }

    async function loadStoredChatHistory() {
      try {
        if (!n2VaultUnlocked) return;
        let store = await n2VaultGet(N2_VAULT_HISTORY_KEY, null);
        if (!store) {
          const legacyRaw = localStorage.getItem(STORAGE_KEY);
          if (legacyRaw) {
            store = JSON.parse(legacyRaw) || {};
            await n2VaultSet(N2_VAULT_HISTORY_KEY, store);
            localStorage.removeItem(STORAGE_KEY);
          }
        }
        if (store) {
          Object.keys(store).forEach(peerId => {
            ensurePeerWindowExists(peerId);
            (store[peerId] || []).forEach(item => {
              if (item.type === 'nudge') renderNudgeUI(peerId, item.sender, false);
              else if (item.type === 'chat') {
                const historyMsgId = item.msgId || ('hist-' + Math.random().toString(36).substring(2, 9));
                item.msgId = historyMsgId;
                renderMessageUI(peerId, item.text, item.direction, item.sender, item.tag, false, item.isBuffered, historyMsgId, item.senderId || item.sender);
              } else if (item.type === 'peertube') {
                renderPeerTubeCardUI(peerId, {embedUrl:item.embedUrl,direction:item.direction,sender:item.sender,senderId:item.senderId || item.sender,isBuffered:item.isBuffered}, false);
              }
            });
          });
        }
      } catch (e) { console.error("Error loading secure history:", e); }
    }

    async function clearStoredChat() {
      if (confirm(`Weet je zeker dat je de chathistorie van '${escapeHTML(activePeerId)}' wilt wissen?`)) {
        try {
          const store = await n2VaultGet(N2_VAULT_HISTORY_KEY, {}) || {};
          delete store[activePeerId];
          await n2VaultSet(N2_VAULT_HISTORY_KEY, store);
          localStorage.removeItem(STORAGE_KEY);
          const win = document.getElementById(`window-${activePeerId}`);
          if (win) win.innerHTML = '';
          ensurePeerWindowExists(activePeerId);
          showToast(`Geschiedenis voor ${escapeHTML(activePeerId)} gewist!`);
        } catch (e) { console.error(e); }
