    function promptSharePeerTube() {
      const input = prompt("Voer een PeerTube-video-URL of Video Embed-URL in:\n(E.g.: https://peertube.stream/w/sOmEVid3oID of https://framatube.org/w/...)");
      if (!input) return;

      let embedUrl = parsePeerTubeUrl(input.trim());
      if (!embedUrl) {
        alert("Ongeldige PeerTube URL/ID. Zorg voor een geldige videolink.");
        return;
      }

      sharePeerTubeVideo(embedUrl);
    }

    function parsePeerTubeUrl(urlStr) {
      try {
        const raw = String(urlStr || '').trim();
        if (!/^https?:\/\//i.test(raw)) return null;
        const url = new URL(raw);
        if (url.username || url.password || url.port) return null;
        if (!/^https?:$/.test(url.protocol)) return null;
        const cleanPath = url.pathname.replace(/\/+/g,'/');
        let videoId = '';
        if (cleanPath.includes('/w/embed/')) videoId = cleanPath.split('/w/embed/')[1].split('/')[0];
        else if (cleanPath.includes('/videos/embed/')) videoId = cleanPath.split('/videos/embed/')[1].split('/')[0];
        else if (cleanPath.includes('/w/')) videoId = cleanPath.split('/w/')[1].split('/')[0];
        else if (cleanPath.includes('/videos/watch/')) videoId = cleanPath.split('/videos/watch/')[1].split('/')[0];
        if (!videoId || !/^[A-Za-z0-9_-]{3,200}$/.test(videoId)) return null;
        return `${url.origin}/videos/embed/${encodeURIComponent(videoId)}`;
      } catch (_) { return null; }
    }

    function n2SendGroupPeerTube(groupId, embedUrl, msgId) {
      const g=n2Groups.get(groupId); if(!g) return false;
      const payload={type:'peertube',groupId:g.id,groupName:g.name,members:Array.from(g.members),embedUrl,msgId,sender:currentFullID,tag:'Groepschat'};
      let sent=false;
      g.members.forEach(id=>{if(id===currentFullID)return;const conn=activeConnections.get(id);if(conn){sendSecure(conn,payload);sent=true;}else{enqueueMessage(id,payload);}});
      return sent;
    }

    function sharePeerTubeVideo(embedUrl) {
      const msgId = 'pt-' + Math.random().toString(36).substring(2, 9);
      const isConnected = activeConnections.has(activePeerId);

      const payload = {
        type: 'peertube',
        embedUrl: embedUrl,
        msgId: msgId
      };

      if (n2Groups.has(activePeerId)) {
        const sent=n2SendGroupPeerTube(activePeerId,embedUrl,msgId);
        renderPeerTubeCardUI(activePeerId,{embedUrl,direction:'outgoing',sender:sent?'You':'Jij (gebufferd)',senderId:currentFullID,isBuffered:!sent},true,msgId);
      } else if (activePeerId === 'system') {
        payload.channel = 'system';
        payload.sender = currentFullID;
        renderPeerTubeCardUI('system', {
          embedUrl: embedUrl,
          direction: 'outgoing',
          sender: 'You',
          senderId: currentFullID,
          isBuffered: false
        }, true, msgId);

        activeConnections.forEach(conn => sendSecure(conn, payload));
      } else {
        const conn = activeConnections.get(activePeerId);
        if (conn) {
          sendSecure(conn, payload);
          renderPeerTubeCardUI(activePeerId, {
            embedUrl: embedUrl,
            direction: 'outgoing',
            sender: 'You',
            senderId: currentFullID,
            isBuffered: false
          }, true, msgId);
        } else {
          enqueueMessage(activePeerId, payload);
          renderPeerTubeCardUI(activePeerId, {
            embedUrl: embedUrl,
            direction: 'outgoing',
            sender: 'Jij (gebufferd)',
            senderId: currentFullID,
            isBuffered: true
          }, true, msgId);
        }
      }
      playAudioPreset(currentMsgSound);
    }

