    body {
      background: var(--cwl-bg);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      color: var(--cwl-text-main);
      overflow-x: hidden;
      transition: background 0.4s ease;
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    }

    .bg-blob {
      position: absolute;
      border-radius: 50%;
      filter: blur(90px);
      z-index: 0;
      opacity: 0.28;
      animation: float 12s infinite alternate ease-in-out;
    }
    .bg-blob-1 { width: 380px; height: 380px; background: #0ea5e9; top: 10%; left: 15%; }
    .bg-blob-2 { width: 420px; height: 420px; background: #a855f7; bottom: 10%; right: 15%; animation-delay: -6s; }

    @keyframes float {
      0% { transform: translate(0, 0) scale(1); }
      100% { transform: translate(30px, -30px) scale(1.08); }
    }

