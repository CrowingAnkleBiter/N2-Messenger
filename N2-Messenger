    .chat-container, .messenger-window {
      position: relative;
      z-index: 10;
      width: 980px;
      max-width: 100%;
      height: 780px;
      max-height: 100vh;
      background: var(--cwl-surface);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border: 1px solid var(--cwl-glass-border);
      border-radius: var(--cwl-radius-lg);
      box-shadow: var(--cwl-shadow);
      display: flex;
      flex-direction: column;
      overflow: hidden;
      transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    }

    /* V5.8 background layer: keeps image editing separate from messenger content. */
    .messenger-window > #n2BackgroundLayer {
      position: absolute;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      background-color: transparent;
      background-position: center;
      background-repeat: no-repeat;
      background-size: cover;
      transition: background .2s ease, filter .2s ease;
    }
    .messenger-window > *:not(#n2BackgroundLayer) { position: relative; z-index: 1; }

