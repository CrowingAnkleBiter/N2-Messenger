    // ==========================================
    // QUEUE BUFFER SYSTEM LOGIC
    // ==========================================

    function enqueueMessage(peerId, payload) {
      if (!messageQueues.has(peerId)) {
        messageQueues.set(peerId, []);
      }
      messageQueues.get(peerId).push(payload);
      saveQueueBuffersToStorage();
      renderZijbalkTabs();
      showToast(`Packet buffered in queue for node: ${escapeHTML(peerId)}`);
    }

    function flushMessageQueue(peerId, conn) {
      // Bewaar de persistente wachtrij totdat de E2E-handshake klaar is.
      if (!secureSessions.get(peerId)?.established) return;
      if (!messageQueues.has(peerId)) return;
      const queue = messageQueues.get(peerId);
      if (!queue || queue.length === 0) return;

      showToast(`Send van ${queue.length} gebufferde items naar ${escapeHTML(peerId)}...`);

      while (queue.length > 0) {
        const payload = queue.shift();
        
        if (payload.type === 'file-transfer') {
          sendSecure(conn, payload.header);
          (payload.chunks || []).forEach(chunk => sendSecure(conn, {type:'file-chunk',transferId:payload.header.transferId,chunk}));
        } else {
          sendSecure(conn, payload);
        }

        if (payload.msgId) {
          const el = document.getElementById(`msg-bubble-${payload.msgId}`);
          if (el) el.classList.remove('buffered');
        }
      }

      saveQueueBuffersToStorage();
      renderZijbalkTabs();
      showToast(`Queue buffer leeggemaakt voor ${escapeHTML(peerId)}!`);
    }

    async function saveQueueBuffersToStorage() {
      try {
        const obj = {};
        messageQueues.forEach((queue, peerId) => {
          const serializableQueue = queue.filter(item => item.type !== 'file-transfer');
          if (serializableQueue.length > 0) obj[peerId] = serializableQueue;
        });
        if (n2VaultUnlocked) {
          await n2VaultSet(N2_VAULT_QUEUE_KEY, obj);
          localStorage.removeItem(QUEUE_STORAGE_KEY);
        }
      } catch (e) { console.error("Error securely saving queue buffers:", e); }
    }

    async function loadStoredQueueBuffers() {
      try {
        if (!n2VaultUnlocked) return;
        let obj = await n2VaultGet(N2_VAULT_QUEUE_KEY, null);
        if (!obj) {
          const legacy = localStorage.getItem(QUEUE_STORAGE_KEY);
          if (legacy) {
            obj = JSON.parse(legacy);
            await n2VaultSet(N2_VAULT_QUEUE_KEY, obj);
            localStorage.removeItem(QUEUE_STORAGE_KEY);
          }
        }
        if (obj) Object.keys(obj).forEach(peerId => messageQueues.set(peerId, obj[peerId]));
      } catch (e) { console.error("Error loading secure queue buffers:", e); }
    }

