        start: normalizeN2GradientColor(document.getElementById('n2BgGradientStart')?.value, '#A855F7'),
        end: normalizeN2GradientColor(document.getElementById('n2BgGradientEnd')?.value, '#0EA5E9'),
        angle: Math.max(0, Math.min(360, parseInt(document.getElementById('n2BgGradientAngle')?.value, 10) || 135))
      };
    }

    function updateN2GradientPreview(start, end, angle) {
      const gradient = `linear-gradient(${angle}deg, ${start}, ${end})`;
      const preview = document.getElementById('n2BgGradientPreview');
      if (preview) preview.style.background = gradient;

      document.querySelectorAll('.n2-gradient-preset').forEach(btn => {
        const inline = btn.style.background || '';
        const normalized = inline.replace(/\s+/g, '').toUpperCase();
        const target = `LINEAR-GRADIENT(${angle}DEG,${start},${end})`.replace(/\s+/g, '').toUpperCase();
        btn.classList.toggle('active', normalized.includes(target));
      });
    }

    function applyN2InterfaceGradient(start, end) {
      start = normalizeN2GradientColor(start, '#A855F7');
      end = normalizeN2GradientColor(end, '#0EA5E9');

      const root = document.documentElement;
      const body = document.body;

      // De interface gebruikt exact dezelfde twee accentkleuren als de achtergrondgradient.
      root.style.setProperty('--n2-gradient-start', start);
      root.style.setProperty('--n2-gradient-end', end);
      root.style.setProperty('--theme-a', start);
      root.style.setProperty('--theme-b', end);
      root.style.setProperty('--theme-bg', `color-mix(in srgb, ${start} 12%, #05070b)`);
      root.style.setProperty('--theme-deep', `color-mix(in srgb, ${end} 9%, #020305)`);
      root.style.setProperty('--theme-surface', `color-mix(in srgb, ${start} 9%, #0b0f14)`);
      root.style.setProperty('--theme-card', `color-mix(in srgb, ${end} 11%, #11161d)`);
      root.style.setProperty('--theme-glow', `color-mix(in srgb, ${start} 35%, transparent)`);

      root.style.setProperty('--cwl-bubble-user', `linear-gradient(135deg, ${start}, ${end})`);
      root.style.setProperty('--cwl-bubble-ai', `linear-gradient(135deg, ${end}, ${start})`);
      root.style.setProperty('--cwl-bg', `color-mix(in srgb, ${start} 12%, #05070b)`);
      root.style.setProperty('--cwl-bg-deeper', `color-mix(in srgb, ${end} 9%, #020305)`);
      root.style.setProperty('--cwl-surface', `color-mix(in srgb, ${start} 9%, #0b0f14)`);
      root.style.setProperty('--cwl-surface-card', `color-mix(in srgb, ${end} 11%, #11161d)`);
      root.style.setProperty('--cwl-glow-purple', `0 0 20px color-mix(in srgb, ${start} 38%, transparent)`);
      root.style.setProperty('--cwl-glow-cyan', `0 0 20px color-mix(in srgb, ${end} 38%, transparent)`);

      // Een custom gradient is een eigen interface-thema.
      body.setAttribute('data-interface-theme', 'custom-gradient');
      body.classList.remove('theme-cyberpunk', 'theme-matrix');

      document.querySelectorAll('.theme-swatch').forEach(swatch => swatch.classList.remove('active'));
    }

    function saveBackgroundEditorSettings() {
      const layer = getBackgroundLayer(); if (!layer) return;
      const g = getN2GradientSettings();
      const settings = {
        brightness: document.getElementById('n2BgBrightness')?.value || '100',
        contrast: document.getElementById('n2BgContrast')?.value || '100',
        saturation: document.getElementById('n2BgSaturation')?.value || '100',
        blur: document.getElementById('n2BgBlur')?.value || '0',
        size: document.getElementById('n2BgSize')?.value || 'cover',
        position: document.getElementById('n2BgPosition')?.value || 'center',
        color: layer.style.backgroundColor || 'transparent',
        gradientStart: g.start,
        gradientEnd: g.end,
        gradientAngle: g.angle
      };
      localStorage.setItem(N2_BG_SETTINGS_KEY, JSON.stringify(settings));
    }

    function applyBackgroundEditor(save = true) {
      const layer = getBackgroundLayer(); if (!layer) return;
      const b = document.getElementById('n2BgBrightness')?.value || 100;
      const c = document.getElementById('n2BgContrast')?.value || 100;
      const sat = document.getElementById('n2BgSaturation')?.value || 100;
      const blur = document.getElementById('n2BgBlur')?.value || 0;
      layer.style.filter = `brightness(${b}%) contrast(${c}%) saturate(${sat}%) blur(${blur}px)`;
      layer.style.backgroundSize = document.getElementById('n2BgSize')?.value || 'cover';
      layer.style.backgroundPosition = document.getElementById('n2BgPosition')?.value || 'center';
      if (save) saveBackgroundEditorSettings();
    }

    function applyBackgroundGradientFromControls(save = true) {
      const g = getN2GradientSettings();
      setBackgroundGradient(g.start, g.end, g.angle, save);
    }

    function setBackgroundGradient(start, end, angle = 135, save = true) {
      const layer = getBackgroundLayer(); if (!layer) return;

      start = normalizeN2GradientColor(start, '#A855F7');
      end = normalizeN2GradientColor(end, '#0EA5E9');
      angle = Math.max(0, Math.min(360, parseInt(angle, 10) || 135));

      const startInput = document.getElementById('n2BgGradientStart');
      const endInput = document.getElementById('n2BgGradientEnd');
      const angleInput = document.getElementById('n2BgGradientAngle');
      if (startInput) startInput.value = start.toLowerCase();
      if (endInput) endInput.value = end.toLowerCase();
      if (angleInput) angleInput.value = String(angle);

      layer.style.backgroundImage = `linear-gradient(${angle}deg, ${start}, ${end})`;
      layer.style.backgroundColor = 'transparent';

      updateN2GradientPreview(start, end, angle);
      applyN2InterfaceGradient(start, end);

      // Een gradient is een eigen achtergrond; een eerder geüploade foto wordt verwijderd.
      localStorage.removeItem('n2_chat_background');

      if (save) {
        saveBackgroundEditorSettings();
        try {
          localStorage.setItem('N2_V5_8_ACTIVE_GRADIENT', JSON.stringify({
            start, end, angle
          }));
        } catch (e) {}
      }

      updateBackgroundNoneButton();
      if (save) showToast(`N² gradient toegepast: ${start} → ${end}`);
    }

    function loadBackgroundEditorSettings() {
      try {
        const raw = localStorage.getItem(N2_BG_SETTINGS_KEY);
        if (!raw) {
          applyBackgroundEditor(false);
          return;
        }

        const s = JSON.parse(raw);

        ['brightness','contrast','saturation','blur'].forEach(k => {
          const el = document.getElementById('n2Bg' + k.charAt(0).toUpperCase() + k.slice(1));
          if (el && s[k] != null) el.value = s[k];
        });

        if (document.getElementById('n2BgSize') && s.size) {
          document.getElementById('n2BgSize').value = s.size;
        }
        if (document.getElementById('n2BgPosition') && s.position) {
          document.getElementById('n2BgPosition').value = s.position;
        }

        const layer = getBackgroundLayer();

        if (s.gradientStart && s.gradientEnd) {
          const start = normalizeN2GradientColor(s.gradientStart, '#A855F7');
          const end = normalizeN2GradientColor(s.gradientEnd, '#0EA5E9');
          const angle = Math.max(0, Math.min(360, parseInt(s.gradientAngle, 10) || 135));

          document.getElementById('n2BgGradientStart').value = start.toLowerCase();
          document.getElementById('n2BgGradientEnd').value = end.toLowerCase();
          document.getElementById('n2BgGradientAngle').value = String(angle);

          if (!localStorage.getItem('n2_chat_background') && layer) {
            layer.style.backgroundImage = `linear-gradient(${angle}deg, ${start}, ${end})`;
            layer.style.backgroundColor = 'transparent';
            updateN2GradientPreview(start, end, angle);
            applyN2InterfaceGradient(start, end);
          }
        } else if (layer && s.color) {
          layer.style.backgroundColor = s.color;
        }

        applyBackgroundEditor(false);
      } catch(e) {
        console.warn('N² V5.8 background settings:', e);
      }
    }

    function updateBackgroundNoneButton() {
      const layer = getBackgroundLayer();
      const btn = document.getElementById('n2BgNoneBtn');
      if (!layer || !btn) return;

      const settings = localStorage.getItem(N2_BG_SETTINGS_KEY);
      let hasGradient = false;
      try {
        const s = settings ? JSON.parse(settings) : null;
        hasGradient = !!(s && s.gradientStart && s.gradientEnd);
      } catch(e) {}

      const hasPhoto = !!localStorage.getItem('n2_chat_background');
      btn.classList.toggle('active', !hasPhoto && !hasGradient);
    }

    function setBackgroundNone() {
      const layer = getBackgroundLayer(); if (!layer) return;

      // Geen eigen achtergrond: standaard N²-logo/achtergrond terugzetten.
      layer.style.backgroundImage = `url('${DEFAULT_BACKGROUND_DATA}')`;
      layer.style.backgroundColor = 'transparent';

      localStorage.removeItem('n2_chat_background');
      localStorage.removeItem(N2_BG_SETTINGS_KEY);
      localStorage.removeItem('N2_V5_8_ACTIVE_GRADIENT');

      ['brightness','contrast','saturation'].forEach(k => {
        const el = document.getElementById('n2Bg' + k.charAt(0).toUpperCase() + k.slice(1));
        if (el) el.value = '100';
      });

      const blur = document.getElementById('n2BgBlur'); if (blur) blur.value = '0';
      const size = document.getElementById('n2BgSize'); if (size) size.value = 'cover';
      const pos = document.getElementById('n2BgPosition'); if (pos) pos.value = 'center';

