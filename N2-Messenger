function n2mcRender(){const grid=$('n2mcGrid'),mix=$('n2mcMixer');if(!grid||!mix)return;grid.innerHTML='';mix.innerHTML='';state.tracks.forEach((tr,ti)=>{const row=document.createElement('div');row.className='n2mc-track'+(((state.selectedTrackId===tr.id)||(state.selectedTrackIds||[]).includes(tr.id))?' selected':'');row.draggable=true;row.dataset.trackId=tr.id;row.addEventListener('dblclick',e=>{if(e.target.closest('button,input,select,label'))return;const tl=$('n2mcTimeline');const lane=tl&&tl.querySelector('.n2mc-lane[data-track-id="'+tr.id+'"]');if(!lane)return;const rect=lane.getBoundingClientRect();const totalSteps=Math.max(64,...state.tracks.flatMap(t=>(t.clips||[]).map(c=>(Number(c.start)||0)+(Number(c.duration)||1))));const x=e.clientX-rect.left;state.editPositionSteps=Math.max(0,Math.min(totalSteps-1,Math.floor(x/(rect.width/totalSteps))));state.selectedTrackId=tr.id;n2mcRenderTimeline();n2mcRefreshHint('Bewerkpositie: '+(state.editPositionSteps*stepDuration()).toFixed(2)+' s');});row.addEventListener('click',e=>{if(e.target.closest('button,input,select,label'))return;state.selectedTrackIds=state.selectedTrackIds||[];if(state.selectedTrackIds.includes(tr.id)){state.selectedTrackIds=state.selectedTrackIds.filter(id=>id!==tr.id);if(state.selectedTrackId===tr.id)state.selectedTrackId=state.selectedTrackIds[0]||null;n2mcRender();n2mcRefreshHint('Spoor gedeselecteerd: '+tr.name);}else{state.selectedTrackIds.push(tr.id);state.selectedTrackId=tr.id;n2mcRender();n2mcRefreshHint('Geselecteerd spoor: '+tr.name);}});row.style.setProperty('--track-color',tr.color);row.addEventListener('dragstart',e=>{state.dragTrackId=tr.id;e.dataTransfer.setData('text/n2mc-track',tr.id);row.classList.add('dragging');});row.addEventListener('dragend',()=>{row.classList.remove('dragging');document.querySelectorAll('.n2mc-track.drag-over').forEach(x=>x.classList.remove('drag-over'));});row.addEventListener('dragover',e=>{if(state.dragTrackId&&state.dragTrackId!==tr.id){e.preventDefault();row.classList.add('drag-over');}});row.addEventListener('dragleave',()=>row.classList.remove('drag-over'));row.addEventListener('drop',e=>{e.preventDefault();row.classList.remove('drag-over');const from=state.tracks.findIndex(x=>x.id===state.dragTrackId),to=state.tracks.findIndex(x=>x.id===tr.id);if(from>=0&&to>=0&&from!==to){const moved=state.tracks.splice(from,1)[0];state.tracks.splice(to,0,moved);state.dragTrackId=null;n2mcRender();n2mcSaveLocal(true);}});const head=document.createElement('div');head.className='n2mc-trackhead';head.innerHTML='<button type="button" class="n2mc-draghandle" title="Sleep om spoor te verplaatsen" aria-label="Sleep spoor">⠿</button><span class="n2mc-trackname" title="'+tr.name+'">'+tr.name+'</span><button type="button" class="n2mc-mute '+(tr.mute?'on':'')+'" aria-label="Mute '+tr.name+'" title="Mute" data-action="mute">M</button><button type="button" class="n2mc-mute '+(tr.solo?'on':'')+'" aria-label="Solo '+tr.name+'" title="Solo" data-action="solo">S</button><button type="button" class="n2mc-track-delete" data-track-delete="true" title="Verwijder dit volledige spoor inclusief bewerkte clips" aria-label="Verwijder spoor">×</button>';head.querySelectorAll('button[data-action]').forEach(b=>b.addEventListener('click',()=>{tr[b.dataset.action]=!tr[b.dataset.action];n2mcRender();}));head.querySelector('[data-track-delete]').addEventListener('click',e=>{e.stopPropagation();window.n2mcDeleteTrack(tr.id);});row.appendChild(head);head.querySelector('.n2mc-trackname').addEventListener('click',()=>{state.selectedTrackId=tr.id;n2mcRender();n2mcRefreshHint('Geselecteerd spoor: '+tr.name);n2mcRenderTimeline();});const mediaTools=document.createElement('div');mediaTools.className='n2mc-rowmedia';[['Mp3','audio'],['MIDI','midi'],['Mic','mic']].forEach(([label,action])=>{const b=document.createElement('button');b.type='button';b.className='n2mc-btn';b.textContent='['+label+']';b.title=label+' toevoegen aan '+tr.name;b.onclick=()=>{state.selectedTrackId=tr.id;if(action==='audio')$('n2mcAudioImport').click();else if(action==='midi')$('n2mcMidiImport').click();else n2mcRecordMic();};mediaTools.appendChild(b);});row.appendChild(mediaTools);for(let i=0;i<16;i++){const b=document.createElement('button');b.type='button';b.className='n2mc-step'+(tr.steps[i]?' active':'');b.dataset.step=i;b.setAttribute('aria-label',tr.name+', step '+(i+1)+(tr.steps[i]?', on':', off'));b.title='Step '+(i+1);b.style.setProperty('--track-color',tr.color);b.addEventListener('click',()=>{state.selectedTrackId=tr.id;tr.steps[i]=tr.steps[i]?0:1;b.classList.toggle('active',!!tr.steps[i]);b.setAttribute('aria-label',tr.name+', step '+(i+1)+(tr.steps[i]?', on':', off'));n2mcSaveLocal(true);});row.appendChild(b);}grid.appendChild(row);
 const r=document.createElement('div');r.className='n2mc-tracktools';const title=document.createElement('strong');title.textContent=tr.name;title.style.color=tr.color;title.style.minWidth='90px';r.appendChild(title);const lev=document.createElement('label');lev.textContent='Level ';const inp=document.createElement('input');inp.type='range';inp.min=0;inp.max=100;inp.value=Math.round(tr.vol*100);inp.setAttribute('aria-label',tr.name+' level');inp.addEventListener('input',()=>{tr.vol=+inp.value/100;val.textContent=inp.value+'%';n2mcSaveLocal(true);});const val=document.createElement('span');val.textContent=inp.value+'%';lev.append(inp,val);r.appendChild(lev);if(['bass','chord','lead','arp'].includes(tr.kind)){const lab=document.createElement('label');lab.textContent='Wave ';const sel=document.createElement('select');sel.className='n2mc-select';['sine','triangle','square','sawtooth'].forEach(w=>{const o=document.createElement('option');o.value=w;o.textContent=w;if((tr.wave||'triangle')===w)o.selected=true;sel.appendChild(o);});sel.addEventListener('change',()=>{tr.wave=sel.value;n2mcSaveLocal(true);});lab.appendChild(sel);r.appendChild(lab);const noteLab=document.createElement('label');noteLab.textContent='Root ';const noteSel=document.createElement('select');noteSel.className='n2mc-select';[[36,'C2'],[38,'D2'],[40,'E2'],[43,'G2'],[45,'A2'],[48,'C3'],[50,'D3'],[52,'E3'],[55,'G3'],[57,'A3'],[60,'C4'],[62,'D4'],[64,'E4'],[67,'G4'],[69,'A4'],[72,'C5'],[74,'D5'],[76,'E5'],[79,'G5'],[81,'A5']].forEach(pair=>{const o=document.createElement('option');o.value=pair[0];o.textContent=pair[1];if(+tr.note===pair[0])o.selected=true;noteSel.appendChild(o);});noteSel.addEventListener('change',()=>{tr.note=+noteSel.value;n2mcSaveLocal(true);});noteLab.appendChild(noteSel);r.appendChild(noteLab);}mix.appendChild(r);});n2mcRenderTimeline();}
window.n2mcSaveLocal=function(silent){try{const data=project();localStorage.setItem(STORE,JSON.stringify(data));if(!silent)status('Project saved in this browser');}catch(e){status('Save failed: local storage unavailable');}};
function project(){return {format:'N2MC',version:2,name:$('n2mcProjectName')?.value||'N² Untitled Beat',bpm:state.bpm,swing:state.swing,length:state.length,master:state.master,tracks:state.tracks.map(t=>({id:t.id,vol:t.vol,wave:t.wave,mute:t.mute,solo:t.solo,steps:t.steps.slice(),note:t.note}))};}
function applyProject(d){if(!d||d.format!=='N2MC'||!Array.isArray(d.tracks))throw new Error('This is not an N² Music Creator project.');state.bpm=clamp(+d.bpm||112,40,240);state.swing=clamp(+d.swing||0,0,60);state.length=d.length===8?8:16;state.master=clamp(d.master==null?.75:+d.master,0,1);state.tracks.forEach(t=>{const x=d.tracks.find(z=>z.id===t.id);if(x){t.steps=Array.from({length:16},(_,i)=>x.steps?.[i]?1:0);t.vol=clamp(x.vol==null?t.vol:+x.vol,0,1);t.wave=x.wave||t.wave;t.mute=!!x.mute;t.solo=!!x.solo;t.note=+x.note||t.note;}});$('n2mcBpm').value=state.bpm;$('n2mcSwing').value=state.swing;$('n2mcSwingVal').textContent=state.swing+'%';$('n2mcMaster').value=Math.round(state.master*100);$('n2mcLength').value=state.length;$('n2mcProjectName').value=String(d.name||'N² Imported Beat').slice(0,80);n2mcSetMaster(state.master*100);n2mcRender();}
function n2mcLoadLocal(){try{const raw=localStorage.getItem(STORE);if(raw){applyProject(JSON.parse(raw));status('Local project restored');}}catch(e){status('Could not restore local project');}}
window.n2mcExportProject=function(){const d=project();dl(new Blob([JSON.stringify(d,null,2)],{type:'application/json'}),safeName(d.name)+'.n2mc.json');status('Project JSON exported');};
window.n2mcImportProject=function(ev){const f=ev.target.files?.[0];if(!f)return;const r=new FileReader();r.onload=()=>{try{applyProject(JSON.parse(r.result));n2mcSaveLocal(true);status('Project imported');}catch(e){status(e.message||'Import failed');}ev.target.value='';};r.readAsText(f);};
function safeName(s){return String(s||'N2-Music-Creator').replace(/[^a-z0-9-_]+/gi,'-').replace(/^-|-$/g,'').slice(0,70)||'N2-Music-Creator';}
function activeEvents(bars=4){const events=[],steps=state.length*bars,beat=60/state.bpm/4;state.tracks.forEach((tr,ti)=>{if(tr.mute||(isSoloed()&&!tr.solo))return;for(let s=0;s<steps;s++){if(tr.steps[s%state.length])events.push({track:tr,ti,step:s,time:s*beat+((s%2===1)?beat*state.swing/100:0),note:tr.note||60,velocity:Math.round(tr.vol*115)});}});return events;}
window.n2mcExportWav=async function(){try{n2mcStop();const bars=4,events=activeEvents(bars),duration=bars*state.length*60/state.bpm/4+1;const rate=44100,off=new OfflineAudioContext(2,Math.ceil(duration*rate),rate),master=off.createGain(),comp=off.createDynamicsCompressor();master.gain.value=state.master;master.connect(comp);comp.connect(off.destination);events.forEach(e=>trigger(off,e.track,e.time,e.velocity/115,master,true));$('n2mcProgress').style.width='25%';status('Rendering WAV…');const buf=await off.startRendering();$('n2mcProgress').style.width='70%';const wav=encodeWav(buf);dl(new Blob([wav],{type:'audio/wav'}),safeName($('n2mcProjectName').value)+'.wav');$('n2mcProgress').style.width='100%';status('WAV exported • 4 bars');setTimeout(()=>$('n2mcProgress').style.width='0%',2500);}catch(e){status('WAV export failed: '+(e.message||e));}}
function encodeWav(buffer){const n=buffer.length,ch=buffer.numberOfChannels,rate=buffer.sampleRate,bytes=2,align=ch*bytes,out=new ArrayBuffer(44+n*align),v=new DataView(out);function str(o,s){for(let i=0;i<s.length;i++)v.setUint8(o+i,s.charCodeAt(i));}str(0,'RIFF');v.setUint32(4,36+n*align,true);str(8,'WAVE');str(12,'fmt ');v.setUint32(16,16,true);v.setUint16(20,1,true);v.setUint16(22,ch,true);v.setUint32(24,rate,true);v.setUint32(28,rate*align,true);v.setUint16(32,align,true);v.setUint16(34,16,true);str(36,'data');v.setUint32(40,n*align,true);const channels=Array.from({length:ch},(_,i)=>buffer.getChannelData(i));let o=44;for(let i=0;i<n;i++)for(let c=0;c<ch;c++){const x=clamp(channels[c][i],-1,1);v.setInt16(o,x<0?x*32768:x*32767,true);o+=2;}return out;}
window.n2mcExportMidi=function(){const ppq=480,ticksPerStep=ppq/4,events=activeEvents(4),midiTracks=[];function vlq(n){n=Math.max(0,Math.floor(n));let b=[n&127];while((n>>=7)){b.unshift((n&127)|128);}return b;}function ascii(s){return Array.from(s).map(c=>c.charCodeAt(0));}function chunk(tag,data){return [...ascii(tag),data.length>>>24&255,data.length>>>16&255,data.length>>>8&255,data.length&255,...data];}function trackChunk(list){list.sort((a,b)=>a.tick-b.tick);let data=[],last=0;list.forEach(e=>{data.push(...vlq(e.tick-last),...e.bytes);last=e.tick;});data.push(0,255,47,0);return chunk('MTrk',data);}const tempo=Math.round(60000000/state.bpm);midiTracks.push(trackChunk([{tick:0,bytes:[255,81,3,(tempo>>16)&255,(tempo>>8)&255,tempo&255]},{tick:0,bytes:[255,88,4,4,2,24,8]}]));state.tracks.forEach((tr,ti)=>{const list=[{tick:0,bytes:[255,3,tr.name.charCodeAt(0)||78,...Array.from(tr.name.slice(1)).map(c=>c.charCodeAt(0))]}];events.filter(e=>e.track.id===tr.id).forEach(e=>{const note=tr.kind==='kick'?36:tr.kind==='snare'?38:tr.kind==='hat'?42:tr.kind==='perc'?46:clamp((e.note||60)+((tr.kind==='arp')?[0,7,12,4][e.step%4]:0),0,127),start=Math.round(e.step*ticksPerStep),dur=tr.kind==='kick'?90:tr.kind==='hat'?45:160;list.push({tick:start,bytes:[0x90+ (tr.kind==='kick'||tr.kind==='snare'||tr.kind==='hat'||tr.kind==='perc'?9:ti%9),note,e.velocity]},{tick:start+dur,bytes:[0x80+(tr.kind==='kick'||tr.kind==='snare'||tr.kind==='hat'||tr.kind==='perc'?9:ti%9),note,0]});});midiTracks.push(trackChunk(list));});const header=[...ascii('MThd'),0,0,0,6,0,1,(midiTracks.length>>8)&255,midiTracks.length&255,(ppq>>8)&255,ppq&255];const all=[...header,...midiTracks.flat()];dl(new Blob([new Uint8Array(all)],{type:'audio/midi'}),safeName($('n2mcProjectName').value)+'.mid');status('MIDI exported • 4 bars');};
