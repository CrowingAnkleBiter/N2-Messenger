    async function handleFileSelected(event) {
      const file = event?.target?.files?.[0];
      if (!file) return;
      if (!Number.isSafeInteger(file.size) || file.size <= 0 || file.size > N2_MAX_FILE_SIZE) {
        showToast(`Ongeldig bestand of groter dan ${Math.round(N2_MAX_FILE_SIZE / 1024 / 1024)} MB.`);
        event.target.value = '';
        return;
      }
      const transferId = 'file-' + crypto.randomUUID();
      const safeFileName = String(file.name || 'bestand').replace(/[\u0000-\u001F\u007F]/g, '').slice(0, N2_MAX_TRANSFER_NAME) || 'bestand';
      const safeFileType = String(file.type || 'application/octet-stream').slice(0, N2_MAX_TRANSFER_MIME);
      let fileHash, fullBuffer;
      try {
        fullBuffer = await file.arrayBuffer();
        fileHash = n2Base64(new Uint8Array(await crypto.subtle.digest('SHA-256', fullBuffer)));
      } catch (_) {
        showToast('Bestand kon niet cryptografisch worden voorbereid.');
        event.target.value = '';
        return;
      }
      const isConnected = activeConnections.has(activePeerId);

      if (activePeerId !== 'system' && !isConnected) {
        const chunks = [];
        for (let i = 0; i < fullBuffer.byteLength; i += CHUNK_SIZE) chunks.push(n2Base64(new Uint8Array(fullBuffer.slice(i, i + CHUNK_SIZE))));
        enqueueMessage(activePeerId, {
          type: 'file-transfer',
          header: {type:'file-header',transferId,fileName:safeFileName,fileSize:file.size,fileType:safeFileType,sha256:fileHash,sender:currentFullID},
          chunks
        });
        renderFileCardUI(activePeerId,{fileName:safeFileName,fileSize:file.size,direction:'outgoing',sender:'Jij (gebufferd)',transferId,isBuffered:true});
        event.target.value = '';
        return;
      }

      const targetPeers = activePeerId === 'system' ? Array.from(activeConnections.values()) : [activeConnections.get(activePeerId)].filter(Boolean);
      const isBroadcast = activePeerId === 'system';
      targetPeers.forEach(conn => sendSecure(conn,{type:'file-header',channel:isBroadcast?'system':'direct',transferId,fileName:safeFileName,fileSize:file.size,fileType:safeFileType,sha256:fileHash,sender:currentFullID}));
      renderFileCardUI(activePeerId,{fileName:safeFileName,fileSize:file.size,direction:'outgoing',sender:'You',senderId:currentFullID,channel:isBroadcast?'system':'direct',transferId,isBuffered:false});
      for (let offset=0; offset<fullBuffer.byteLength; offset+=CHUNK_SIZE) {
        const chunk=fullBuffer.slice(offset,offset+CHUNK_SIZE);
        targetPeers.forEach(conn=>sendSecure(conn,{type:'file-chunk',transferId,chunk:n2Base64(new Uint8Array(chunk))}));
        updateFileProgressUI(transferId,Math.min(100,Math.round(((offset+chunk.byteLength)/file.size)*100)));
        await new Promise(r=>setTimeout(r,0));
      }
      showToast(`Bestand '${escapeHTML(safeFileName)}' succesvol verzonden en gehasht.`);
      event.target.value = '';
    }

    function initIncomingFileTransfer(peerId, header) {
      if (!peerId || !header || typeof header !== 'object') return;
      const transferId=String(header.transferId||'');
      const fileName=String(header.fileName||'bestand').replace(/[\u0000-\u001F\u007F]/g,'').slice(0,N2_MAX_TRANSFER_NAME)||'bestand';
      const fileSize=Number(header.fileSize);
      const fileType=String(header.fileType||'application/octet-stream').slice(0,N2_MAX_TRANSFER_MIME);
      const sha256=String(header.sha256||'');
      if(!/^file-[0-9a-f-]{36}$/i.test(transferId)||!Number.isSafeInteger(fileSize)||fileSize<=0||fileSize>N2_MAX_FILE_SIZE||!/^[A-Za-z0-9+/=]{43,44}$/.test(sha256)){
        showToast('⚠️ Ongeldig bestandsoverdracht-verzoek geblokkeerd.'); return;
      }
      if(incomingFiles.has(transferId)) return;
      const isBroadcast=header.channel==='system', targetWindow=isBroadcast?'system':peerId;
      incomingFiles.set(transferId,{peerId,targetWindow,channel:header.channel||'direct',senderId:header.sender||peerId,fileName,fileSize,fileType,sha256,playlist:!!header.playlist||header.channel==='playlist',playlistTrackId:header.playlistTrackId||null,receivedBytes:0,chunks:[]});
      renderFileCardUI(targetWindow,{fileName,fileSize,direction:'incoming',sender:peerId,senderId:header.sender||peerId,channel:header.channel||'direct',transferId});
      playAudioPreset(currentMsgSound);
    }

    async function handleIncomingFileChunk(peerId,transferId,encodedChunk){
      const state=incomingFiles.get(String(transferId||'')); if(!state||state.peerId!==peerId)return;
      try{
        const bytes=n2FromBase64(encodedChunk); if(!bytes.length||bytes.length>CHUNK_SIZE)throw new Error('INVALID_CHUNK');
        if(state.receivedBytes+bytes.byteLength>state.fileSize)throw new Error('OVERFLOW');
        state.chunks.push(bytes.buffer.slice(bytes.byteOffset,bytes.byteOffset+bytes.byteLength)); state.receivedBytes+=bytes.byteLength;
        updateFileProgressUI(transferId,Math.min(100,Math.round(state.receivedBytes/state.fileSize*100)));
        if(state.receivedBytes>=state.fileSize)await completeIncomingFileDownload(transferId,state);
      }catch(_){incomingFiles.delete(String(transferId||''));showToast('⚠️ Ongeldige bestandchunk geblokkeerd.');}
    }

    async function completeIncomingFileDownload(transferId,fileState){
      const blob=new Blob(fileState.chunks,{type:fileState.fileType||'application/octet-stream'});
      if(blob.size!==fileState.fileSize){incomingFiles.delete(transferId);showToast('⚠️ Bestandsgrootte klopt niet; overdracht geblokkeerd.');return;}
      try{
        const digest=await crypto.subtle.digest('SHA-256',await blob.arrayBuffer());
        if(n2Base64(new Uint8Array(digest))!==fileState.sha256){incomingFiles.delete(transferId);showToast('⚠️ SHA-256-integriteitscontrole mislukt.');return;}
      }catch(_){incomingFiles.delete(transferId);showToast('⚠️ Bestand kon niet cryptografisch worden gecontroleerd.');return;}
      if(fileState.playlist&&fileState.playlistTrackId){incomingFiles.delete(transferId);return;}
      const downloadUrl=URL.createObjectURL(blob),card=document.getElementById(`file-card-${transferId}`);
      if(card){const area=card.querySelector('.file-action-area');if(area){area.textContent='';const a=document.createElement('a');a.href=downloadUrl;a.download=fileState.fileName;a.className='file-download-btn';a.textContent='💾 Downloaden';area.appendChild(a);}}
      showToast(`Bestand '${escapeHTML(fileState.fileName)}' ontvangen en SHA-256 gecontroleerd.`);incomingFiles.delete(transferId);
    }

    function updateFileProgressUI(transferId, percentage) {
      const fill = document.getElementById(`progress-${transferId}`);
      if (fill) fill.style.width = `${percentage}%`;
    }

    function renderFileCardUI(targetWindowPeerId, fileInfo) {
      ensurePeerWindowExists(targetWindowPeerId);
      const windowDiv = document.getElementById(`window-${targetWindowPeerId}`);

      const row = document.createElement('div');
      row.className = `message-row ${fileInfo.direction}`;

      const formattedSize = (fileInfo.fileSize / 1024 / 1024).toFixed(2) + ' MB';

      row.innerHTML = `
        <div class="message-bubble ${fileInfo.isBuffered ? 'buffered' : ''}" style="padding: 8px 12px;">
          <div class="file-card" id="file-card-${fileInfo.transferId}">
