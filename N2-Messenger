      document.documentElement.style.removeProperty('--n2-gradient-start');
      document.documentElement.style.removeProperty('--n2-gradient-end');
      document.documentElement.style.removeProperty('--theme-a');
      document.documentElement.style.removeProperty('--theme-b');
      document.documentElement.style.removeProperty('--theme-bg');
      document.documentElement.style.removeProperty('--theme-deep');
      document.documentElement.style.removeProperty('--theme-surface');
      document.documentElement.style.removeProperty('--theme-card');
      document.documentElement.style.removeProperty('--theme-glow');
      document.documentElement.style.removeProperty('--cwl-bg');
      document.documentElement.style.removeProperty('--cwl-bg-deeper');
      document.documentElement.style.removeProperty('--cwl-surface');
      document.documentElement.style.removeProperty('--cwl-surface-card');
      document.documentElement.style.removeProperty('--cwl-bubble-user');
      document.documentElement.style.removeProperty('--cwl-bubble-ai');
      document.documentElement.style.removeProperty('--cwl-glow-purple');
      document.documentElement.style.removeProperty('--cwl-glow-cyan');
      document.body.removeAttribute('data-interface-theme');
      document.body.classList.remove('theme-cyberpunk', 'theme-matrix');

      applyBackgroundEditor(false);
      updateBackgroundNoneButton();
      showToast('Geen eigen gradient — standaard N²-interface behouden.');
    }

    function setBackgroundSolid(color) {
      // Compatibiliteitsfunctie: oude aanroepen worden automatisch een neutrale gradient.
      const c = normalizeN2GradientColor(color, '#121816');
      setBackgroundGradient(c, c, 135, true);
    }

    function resetBackgroundEditor() {
      setBackgroundNone();
      showToast('Achtergrond en interface teruggezet naar N² standaard.');
    }

    // ==========================================
    // WHITEBOARD LOGICA
    // ==========================================

    function toggleWhiteboard() {
      const overlay = document.getElementById('whiteboardOverlay');
      const btn = document.getElementById('whiteboardToggleBtn');
      isWhiteboardOpen = !isWhiteboardOpen;
      if (isWhiteboardOpen) {
        overlay.style.display = 'flex';
        btn.classList.add('active-focus');
        resizeWhiteboardCanvas();
        loadSavedWhiteboard();
      } else {
        overlay.style.display = 'none';
        btn.classList.remove('active-focus');
      }
    }

    function resizeWhiteboardCanvas() {
      if (!wbCanvas || !isWhiteboardOpen) return;
      if (!wbCanvas.width || !wbCanvas.height) { wbCanvas.width = 1600; wbCanvas.height = 900; }
      // The drawing surface stays 16:9. CSS centers it inside the available area,
      // so focus mode can resize the window without stretching the drawing.
    }

    function pushWhiteboardHistory() {
      if (!wbCanvas) return;
      try {
        wbHistory.push(wbCanvas.toDataURL('image/png'));
        if (wbHistory.length > 30) wbHistory.shift();
      } catch(e) {}
    }
    function restoreWhiteboardDataUrl(dataUrl) {
      if (!wbCtx || !wbCanvas || !dataUrl) return;
      const img = new Image();
      img.onload = () => {
        wbCtx.clearRect(0,0,wbCanvas.width,wbCanvas.height);
        const scale=Math.min(wbCanvas.width/img.width, wbCanvas.height/img.height);
        const w=img.width*scale,h=img.height*scale;
        wbCtx.drawImage(img,(wbCanvas.width-w)/2,(wbCanvas.height-h)/2,w,h);
      };
      img.src=dataUrl;
    }
    function undoWhiteboard() {
      if (!wbHistory.length) { showToast('Niets om ongedaan te maken.'); return; }
      restoreWhiteboardDataUrl(wbHistory.pop());
      saveWhiteboard(false, false);
      showToast('Ongedaan gemaakt.');
    }
    function saveWhiteboard(show = true, exportFile = show) {
      if (!wbCanvas) return;
      try {
        const data=wbCanvas.toDataURL('image/png');
        localStorage.setItem(N2_WB_SAVED_KEY,data);
        if(exportFile){ const a=document.createElement('a'); a.href=data; a.download='N2-Whiteboard-V5.8.png'; document.body.appendChild(a); a.click(); a.remove(); }
        if(show) showToast('Whiteboard opgeslagen als PNG.');
      } catch(e) { console.warn('Whiteboard save:',e); if(show) showToast('Whiteboard opslaan mislukt.'); }
    }
    function loadSavedWhiteboard() {
      const saved=localStorage.getItem(N2_WB_SAVED_KEY);
      if(saved && wbCanvas && isWhiteboardOpen) restoreWhiteboardDataUrl(saved);
    }
    function setWhiteboardColor(color) {
      const hex=normalizeHex(color)||'#38BDF8'; const input=document.getElementById('wbColor'); if(input) input.value=hex.toLowerCase();
      const hexInput=document.getElementById('wbHexColor'); if(hexInput) hexInput.value=hex;
      document.querySelectorAll('.wb-color-swatch').forEach(b=>b.classList.toggle('active',String(b.dataset.color||'').toUpperCase()===hex));
      setWhiteboardGradientMode(false);
      isEraser=false; isWhiteboardFillMode=false;
      const e=document.getElementById('wbEraserBtn'); if(e){e.innerText='✏️ Pen';e.classList.remove('tool-btn-danger');}
      const f=document.getElementById('wbFillBtn'); if(f)f.classList.remove('active-focus');
    }
    function toggleWhiteboardFill() {
      isWhiteboardFillMode=!isWhiteboardFillMode; isEraser=false;
      const f=document.getElementById('wbFillBtn'); if(f)f.classList.toggle('active-focus',isWhiteboardFillMode);
      const e=document.getElementById('wbEraserBtn'); if(e){e.innerText='✏️ Pen';e.classList.remove('tool-btn-danger');}
    }
    function floodFillCanvas(x,y,color) {
      if(!wbCanvas||!wbCtx) return;
      const px=Math.max(0,Math.min(wbCanvas.width-1,Math.floor(x*wbCanvas.width)));
      const py=Math.max(0,Math.min(wbCanvas.height-1,Math.floor(y*wbCanvas.height)));
      const image=wbCtx.getImageData(0,0,wbCanvas.width,wbCanvas.height);
      const data=image.data, idx=(py*wbCanvas.width+px)*4;
      const target=[data[idx],data[idx+1],data[idx+2],data[idx+3]];
      const c=color.match(/^#([0-9a-f]{6})$/i); if(!c)return;
      const fill=[parseInt(c[1].slice(0,2),16),parseInt(c[1].slice(2,4),16),parseInt(c[1].slice(4,6),16),255];
      if(target.every((v,i)=>v===fill[i])) return;
      const same=(i)=>data[i]===target[0]&&data[i+1]===target[1]&&data[i+2]===target[2]&&data[i+3]===target[3];
      const stack=[[px,py]]; const seen=new Uint8Array(wbCanvas.width*wbCanvas.height);
      while(stack.length){ const [cx,cy]=stack.pop(); if(cx<0||cy<0||cx>=wbCanvas.width||cy>=wbCanvas.height)continue; const si=cy*wbCanvas.width+cx; if(seen[si])continue; seen[si]=1; const di=si*4; if(!same(di))continue; data[di]=fill[0];data[di+1]=fill[1];data[di+2]=fill[2];data[di+3]=fill[3]; stack.push([cx+1,cy],[cx-1,cy],[cx,cy+1],[cx,cy-1]); }
      wbCtx.putImageData(image,0,0);
    }

    function toggleEraser() {
      isEraser = !isEraser; isWhiteboardFillMode=false;
      const btn = document.getElementById('wbEraserBtn');
      const fill = document.getElementById('wbFillBtn'); if(fill) fill.classList.remove('active-focus');
      if (isEraser) { btn.innerText = '🧹 Gum'; btn.classList.add('tool-btn-danger'); }
      else { btn.innerText = '✏️ Pen'; btn.classList.remove('tool-btn-danger'); }
    }

    function initWhiteboardEvents() {
      const getPos = (e) => {
        const rect = wbCanvas.getBoundingClientRect();
        const clientX = e.touches ? e.touches[0].clientX : e.clientX;
        const clientY = e.touches ? e.touches[0].clientY : e.clientY;
        return { x: Math.max(0, Math.min(1, (clientX - rect.left) / rect.width)), y: Math.max(0, Math.min(1, (clientY - rect.top) / rect.height)) };
      };
      const startDrawing = (e) => {
        if(isWhiteboardFillMode){ e.preventDefault(); const p=getPos(e); pushWhiteboardHistory(); const color=document.getElementById('wbColor')?.value||'#38bdf8'; floodFillCanvas(p.x,p.y,color); isWhiteboardFillMode=false; document.getElementById('wbFillBtn')?.classList.remove('active-focus'); saveWhiteboard(false, false); return; }
        pushWhiteboardHistory(); isDrawing = true; const pos = getPos(e); lastX=pos.x; lastY=pos.y;
      };
      const draw = (e) => { if (!isDrawing) return; e.preventDefault(); const pos=getPos(e); const color=isEraser?'rgba(0,0,0,1)':document.getElementById('wbColor').value; const size=parseInt(document.getElementById('wbSize').value)||3; const gStart=(!isEraser && wbGradientMode)?wbGradientStart:null; const gEnd=(!isEraser && wbGradientMode)?wbGradientEnd:null; drawSegment(lastX,lastY,pos.x,pos.y,color,size,isEraser,gStart,gEnd); broadcastWhiteboardDraw(lastX,lastY,pos.x,pos.y,color,size,isEraser,gStart,gEnd); lastX=pos.x;lastY=pos.y; };
      const stopDrawing = () => { if(isDrawing) saveWhiteboard(false, false); isDrawing=false; };
      wbCanvas.addEventListener('mousedown',startDrawing); wbCanvas.addEventListener('mousemove',draw); wbCanvas.addEventListener('mouseup',stopDrawing); wbCanvas.addEventListener('mouseleave',stopDrawing);
      wbCanvas.addEventListener('touchstart',startDrawing,{passive:false}); wbCanvas.addEventListener('touchmove',draw,{passive:false}); wbCanvas.addEventListener('touchend',stopDrawing);
    }

    function drawSegment(x1,y1,x2,y2,color,size,erasing,gStart=null,gEnd=null) {
      if(!wbCtx)return; wbCtx.beginPath(); wbCtx.moveTo(x1*wbCanvas.width,y1*wbCanvas.height); wbCtx.lineTo(x2*wbCanvas.width,y2*wbCanvas.height);
      wbCtx.globalCompositeOperation=erasing?'destination-out':'source-over';
      if(!erasing && gStart && gEnd){ const grad=wbCtx.createLinearGradient(x1*wbCanvas.width,y1*wbCanvas.height,x2*wbCanvas.width,y2*wbCanvas.height); grad.addColorStop(0,gStart); grad.addColorStop(1,gEnd); wbCtx.strokeStyle=grad; } else wbCtx.strokeStyle=erasing?'rgba(0,0,0,1)':color; wbCtx.lineWidth=size; wbCtx.lineCap='round'; wbCtx.lineJoin='round'; wbCtx.stroke(); wbCtx.globalCompositeOperation='source-over';
    }

    function broadcastWhiteboardDraw(x1,y1,x2,y2,color,size,erasing,gStart=null,gEnd=null) {
      const payload={type:'wb-draw',x1,y1,x2,y2,color,size,erasing,gStart,gEnd};
      if(activePeerId==='system') activeConnections.forEach(conn=>sendSecure(conn,payload));
      else { const conn=activeConnections.get(activePeerId); if(conn)sendSecure(conn,payload); else enqueueMessage(activePeerId,payload); }
    }
    function clearWhiteboard(broadcast=true) {
      if(!wbCtx||!wbCanvas)return; pushWhiteboardHistory(); wbCtx.clearRect(0,0,wbCanvas.width,wbCanvas.height); localStorage.removeItem(N2_WB_SAVED_KEY);
      if(broadcast){ const payload={type:'wb-clear'}; if(activePeerId==='system')activeConnections.forEach(conn=>sendSecure(conn,payload)); else {const conn=activeConnections.get(activePeerId);if(conn)sendSecure(conn,payload);else enqueueMessage(activePeerId,payload);} showToast('Whiteboard gewist'); }
    }

    let wbGradientMode = false;
    let wbGradientStart = '#f97316';
    let wbGradientEnd = '#ec4899';
    let wbSavedGradients = [];
    const N2_WB_GRADIENTS_KEY = 'N2_V5_8_WHITEBOARD_GRADIENTS';
    const N2_WB_GRADIENTS_MAX = 24;
    function normalizeHex(v){ const x=String(v||'').trim(); return /^#[0-9a-fA-F]{6}$/.test(x) ? x.toUpperCase() : null; }
    function gradientKey(a,b){ return `${a.toUpperCase()}_${b.toUpperCase()}`; }
    function loadWhiteboardGradients(){
      try {
        const raw=localStorage.getItem(N2_WB_GRADIENTS_KEY);
        const parsed=raw?JSON.parse(raw):[];
        wbSavedGradients=Array.isArray(parsed)?parsed.filter(g=>normalizeHex(g?.start)&&normalizeHex(g?.end)).slice(0,N2_WB_GRADIENTS_MAX).map(g=>({start:normalizeHex(g.start),end:normalizeHex(g.end)})):[];
      } catch(e){ wbSavedGradients=[]; }
      renderWhiteboardGradients();
    }
    function persistWhiteboardGradients(){ try { localStorage.setItem(N2_WB_GRADIENTS_KEY,JSON.stringify(wbSavedGradients)); } catch(e){} }
    function saveCurrentWhiteboardGradient(){
      const a=normalizeHex(wbGradientStart), b=normalizeHex(wbGradientEnd); if(!a||!b)return;
      const key=gradientKey(a,b);
      wbSavedGradients=wbSavedGradients.filter(g=>gradientKey(g.start,g.end)!==key);
      wbSavedGradients.unshift({start:a,end:b});
      if(wbSavedGradients.length>N2_WB_GRADIENTS_MAX) wbSavedGradients=wbSavedGradients.slice(0,N2_WB_GRADIENTS_MAX);
      persistWhiteboardGradients(); renderWhiteboardGradients();
      setWhiteboardGradient(a,b);
      showToast('Gradient opgeslagen.');
    }
    function selectWhiteboardSavedGradient(index){
      const g=wbSavedGradients[index]; if(!g)return;
      setWhiteboardGradient(g.start,g.end);
    }
    function deleteWhiteboardSavedGradient(index){
      if(!wbSavedGradients[index])return;
      wbSavedGradients.splice(index,1); persistWhiteboardGradients(); renderWhiteboardGradients();
    }
    function renderWhiteboardGradients(){
      const host=document.getElementById('wbSavedGradients'); if(!host)return;
      host.innerHTML='';
      wbSavedGradients.forEach((g,i)=>{
        const item=document.createElement('span'); item.className='wb-gradient-saved-item';
        const btn=document.createElement('button'); btn.type='button'; btn.className='wb-gradient-saved-swatch';
        btn.style.background=`linear-gradient(135deg,${g.start},${g.end})`;
        btn.title=`Gradient ${g.start} → ${g.end}`;
        btn.classList.toggle('active',wbGradientMode&&g.start===wbGradientStart&&g.end===wbGradientEnd);
        btn.onclick=()=>selectWhiteboardSavedGradient(i);
        const del=document.createElement('button'); del.type='button'; del.className='wb-gradient-delete'; del.textContent='×'; del.title='Gradient verwijderen';
        del.onclick=(e)=>{e.stopPropagation();deleteWhiteboardSavedGradient(i);};
        item.append(btn,del); host.appendChild(item);
      });
    }
    function setWhiteboardHex(v){ const hex=normalizeHex(v); if(!hex)return; setWhiteboardColor(hex); }
    function setWhiteboardGradientMode(enabled){
      wbGradientMode=!!enabled;
      document.getElementById('wbGradientOff')?.classList.toggle('active',!wbGradientMode);
      document.getElementById('wbGradientWarm')?.classList.toggle('active',wbGradientMode && wbGradientStart==='#F97316' && wbGradientEnd==='#EC4899');
      document.getElementById('wbGradientCool')?.classList.toggle('active',wbGradientMode && wbGradientStart==='#22D3EE' && wbGradientEnd==='#6366F1');
      document.getElementById('wbGradientPanel')?.classList.toggle('open',wbGradientMode);
      document.getElementById('wbColor')?.removeAttribute('disabled');
      isEraser=false; isWhiteboardFillMode=false;
      renderWhiteboardGradients();
    }
    function setWhiteboardGradient(start,end){
      const a=normalizeHex(start), b=normalizeHex(end); if(!a||!b)return;
      wbGradientStart=a; wbGradientEnd=b;
