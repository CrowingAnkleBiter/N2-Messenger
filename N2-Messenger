      if (!stored) {
        try { stored = JSON.parse(localStorage.getItem(N2_IDENTITY_KEY) || 'null'); } catch (_) { stored = null; }
        if (stored && stored.privateJwk && stored.publicJwk) {
          await n2VaultSet(N2_VAULT_IDENTITY_KEY, stored);
          localStorage.removeItem(N2_IDENTITY_KEY);
        }
      }
      if (stored && stored.privateJwk && stored.publicJwk) {
        n2IdentityKeyPair = {
          privateKey: await crypto.subtle.importKey('jwk', stored.privateJwk, {name:'ECDSA',namedCurve:'P-256'}, false, ['sign']),
          publicKey: await crypto.subtle.importKey('jwk', stored.publicJwk, {name:'ECDSA',namedCurve:'P-256'}, false, ['verify'])
        };
        n2IdentityPublicJwk = stored.publicJwk;
        return;
      }
      const pair = await crypto.subtle.generateKey({name:'ECDSA',namedCurve:'P-256'}, true, ['sign','verify']);
      const privateJwk = await crypto.subtle.exportKey('jwk', pair.privateKey);
      const publicJwk = await crypto.subtle.exportKey('jwk', pair.publicKey);
      await n2VaultSet(N2_VAULT_IDENTITY_KEY, {version:2,privateJwk,publicJwk});
      n2IdentityKeyPair = {
        privateKey: await crypto.subtle.importKey('jwk', privateJwk, {name:'ECDSA',namedCurve:'P-256'}, false, ['sign']),
        publicKey: await crypto.subtle.importKey('jwk', publicJwk, {name:'ECDSA',namedCurve:'P-256'}, false, ['verify'])
      };
      n2IdentityPublicJwk = publicJwk;
    }
    async function n2TrustedKeys() {
