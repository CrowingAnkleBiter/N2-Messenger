    function sendEphemeralHandshake() {
      handshakeSequenceCounter++;
      const glyphs = ['∼', '⋮', 'Ↄ', 'CWL+', '→', '↦', '≁', '⊣', 'Φ', 'χ', 'ℵ', '∞', '⚡', '🌌', '⚙', '🛡', '🔒', '∆', 'Ω', 'Ψ'];
      const randomGlyphs = Array.from({ length: 6 }, () => glyphs[Math.floor(Math.random() * glyphs.length)]).join('');
      const dynamicNonce = Math.random().toString(36).substring(2, 8).toUpperCase();
      const timestamp = Date.now().toString(36).toUpperCase();

      const text = `[EPHEMERAL-HS] ${randomGlyphs} | NONCE: ${dynamicNonce}-${timestamp} | Seq: #${handshakeSequenceCounter}`;

      if (activePeerId === 'system') {
        renderMessageUI('system', text, 'outgoing', 'Jij', 'Dynamische Handshake');
        activeConnections.forEach(conn => sendSecure(conn, { type: 'chat', text: text, tag: 'Dynamische Handshake' }));
      } else {
        const conn = activeConnections.get(activePeerId);
        const payload = { type: 'chat', text: text, tag: 'Dynamische Handshake' };
