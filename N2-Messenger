    async function deleteSpecificMessage(peerId, msgId, row) {
      if (!msgId) return;
      if (!confirm('Delete this specific message?')) return;

      try {
        // Deletion must be written to the encrypted history used at next login,
        // not only to the legacy plaintext store.
        if (!n2VaultUnlocked) throw new Error('Secure vault is locked');
        const store = await n2VaultGet(N2_VAULT_HISTORY_KEY, {}) || {};
        if (Array.isArray(store[peerId])) {
          store[peerId] = store[peerId].filter(item => item.msgId !== msgId);
          if (store[peerId].length === 0) delete store[peerId];
        }
        await n2VaultSet(N2_VAULT_HISTORY_KEY, store);

        // Clean up any legacy copy too, if one still exists.
        try {
          const legacyStore = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}') || {};
          if (Array.isArray(legacyStore[peerId])) {
            legacyStore[peerId] = legacyStore[peerId].filter(item => item.msgId !== msgId);
            if (legacyStore[peerId].length === 0) delete legacyStore[peerId];
            localStorage.setItem(STORAGE_KEY, JSON.stringify(legacyStore));
          }
        } catch (_) {}
      } catch (e) {
        console.error('Error deleting message:', e);
        showToast('Message could not be deleted.');
        return;
      }

      if (row && row.parentNode) row.parentNode.removeChild(row);
      showToast('Message deleted.');
    }

