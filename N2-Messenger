    .theme-swatch {
      position: relative;
      width: 22px;
      height: 22px;
      min-width: 22px;
      padding: 0;
      border-radius: 7px;
      border: 1px solid rgba(255,255,255,.28);
      cursor: pointer;
      background: linear-gradient(135deg, var(--swatch-a), var(--swatch-b));
      box-shadow: inset 0 0 0 1px rgba(0,0,0,.12);
      transition: transform .15s ease, box-shadow .15s ease;
